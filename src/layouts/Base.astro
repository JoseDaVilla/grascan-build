---
import { u } from '@/lib/url';
import '@/styles/global.css';
import bodyFontUrl from '@/assets/fonts/kumbh-sans.woff2?url';
import subFontUrl from '@/assets/fonts/cossette-titre-700.woff2?url';
import { site } from '@/site.config';
import { palette } from '@/lib/palette';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  intro?: boolean;
  noindex?: boolean;
  /** Header en tono claro mientras está sobre un hero oscuro (p. ej. ficha de proyecto). */
  darkHero?: boolean;
  /** Oculta el logo del header mientras se ve el hero (la home ya muestra el logo centrado). */
  heroLogo?: boolean;
}

const { title, description = site.description, image = '/og.png', intro = false, noindex = false, darkHero = false, heroLogo = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.legalName}` : `${site.legalName} | ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(u(image), Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  name: site.legalName,
  url: Astro.site?.toString(),
  description: site.description,
  areaServed: 'Ontario, Canada',
  ...(site.email && { email: site.email }),
  ...(site.phone && { telephone: site.phone }),
};
---

<!doctype html>
<html lang="en" id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={palette.bone} />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={u('/sitemap-index.xml')} />
    <link rel="preload" href={bodyFontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={subFontUrl} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.legalName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Antes del primer paint: activa animaciones JS y decide si mostrar la intro -->
    <script is:inline define:vars={{ intro }}>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        // Respaldo: si el JS principal no arrancó (error / navegador viejo), mostrar todo el contenido
        setTimeout(function () { if (!d.classList.contains('reveal-ready')) d.classList.remove('js'); }, 4000);
        // Variante de prueba "fondo Steel Blue": ?steel-blue la activa (se mantiene al navegar en la
        // pestaña) y ?steel-blue=off la quita. Estilos en global.css (html.theme-steel).
        try {
          var sb = location.search.match(/[?&]steel-blue(=([^&]*))?/);
          if (sb) sb[2] === 'off' ? sessionStorage.removeItem('theme-steel') : sessionStorage.setItem('theme-steel', '1');
          if (sessionStorage.getItem('theme-steel')) d.classList.add('theme-steel');
          // Prueba de fuente de párrafo: ?body=teachers | ?body=pathway (se mantiene al navegar); ?body=off la quita
          var bf = location.search.match(/[?&]body=(teachers|pathway|off)\b/);
          if (bf) bf[1] === 'off' ? sessionStorage.removeItem('body-font') : sessionStorage.setItem('body-font', bf[1]);
          var bodyFont = sessionStorage.getItem('body-font');
          if (bodyFont) d.classList.add('body-' + bodyFont);
        } catch (e) {}
        if (!intro) return;
        // En cada carga de la home (salvo reduced motion). Variante por URL: ?intro1 | ?intro2 | ?intro3 | ?intro4 | ?intro5
        // Con reduced motion: el hero de fotos de la variante por defecto, sin intro
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) { d.dataset.intro = '5'; return; }
        var m = location.search.match(/[?&]intro([1-5])\b/);
        var mode = m ? m[1] : '5';
        d.dataset.intro = mode;
        d.classList.add('has-intro');
        setTimeout(function () { d.classList.add('intro-done'); }, mode === '5' ? 1900 : 3200);
      })();
    </script>
  </head>
  <body class="min-h-dvh overflow-x-clip">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[200] focus:bg-signal focus:px-5 focus:py-3 focus:text-on-signal">Skip to content</a>
    <Header darkHero={darkHero} heroLogo={heroLogo} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '@/scripts/main';
    </script>
  </body>
</html>
