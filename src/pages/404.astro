---
import { u } from '@/lib/url';
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
---
<Base title="Page not found" noindex darkHero>
  <section class="on-dark relative flex min-h-[100svh] items-center overflow-hidden bg-ink text-bone">
    <div class="container-x relative">
      <p class="eyebrow text-signal">Error 404</p>
      <h1 class="mt-6 font-wide text-[clamp(5rem,18vw,15rem)] leading-[0.9]">404</h1>
      <p class="mt-8 max-w-md text-lead text-bone/70">This page doesn't exist or has been moved. Let's get you back on site.</p>
      <div class="mt-10 flex flex-wrap gap-3"><Button href={u('/')}>Back to home</Button><Button href={u('/contact')} variant="ghost-light">Contact us</Button></div>
    </div>
  </section>
</Base>
