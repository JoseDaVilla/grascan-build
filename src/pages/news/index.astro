---
import FilterBar from '@/components/FilterBar.astro';
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import NewsCard from '@/components/NewsCard.astro';
import { newsCopy, newsCategories } from '@/data/services';

const posts = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const [feature, ...rest] = posts;
const used = new Set(posts.map((p) => p.data.category));
const categories = newsCategories.map((c) => c.title).filter((c) => used.has(c));
---

<Base title="News & Insights" description={newsCopy.intro[1]}>
  <PageHero eyebrow="News & insights" title="Perspectives from|the people building|what's next." accent={["next."]} lead={newsCopy.intro[0]}>
    <p class="mt-6 max-w-2xl text-ink/70" data-reveal style="--d:4">{newsCopy.intro[1]}</p>
    <ul class="mt-12 grid border-t border-ink/10 sm:grid-cols-2 xl:grid-cols-3" data-reveal style="--d:5">
      {newsCategories.map((c) => (
        <li class="border-b border-ink/10 py-5 sm:pr-5">
          <p class="font-semibold text-signal">{c.title}</p>
          <p class="mt-1 text-sm text-ink/65">{c.text}</p>
        </li>
      ))}
    </ul>
  </PageHero>

  {
    feature && (
      <section class="pt-16 md:pt-24">
        <div class="container-x">
          <NewsCard post={feature} feature />
        </div>
      </section>
    )
  }

  <section class="py-16 md:py-24">
    <div class="container-x">
      {rest.length > 0 && categories.length > 1 && (
        <div class="mb-10 border-t border-ink/10 pt-10 md:mb-12">
          <FilterBar target="news-grid" label="Filter by category" items={categories.map((c) => ({ value: c, label: c }))} />
        </div>
      )}
      <div id="news-grid" class="grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-8 lg:gap-y-16">
        {rest.map((post, i) => <div data-tags={post.data.category}><NewsCard post={post} index={i} /></div>)}
      </div>
      <p class="py-20 text-center text-mute" data-filter-empty hidden>No posts in this category yet.</p>
    </div>
  </section>
</Base>
