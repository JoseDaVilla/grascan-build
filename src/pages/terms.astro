---
import { u } from '@/lib/url';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { site } from '@/site.config';
import { photos } from '@/data/photos';
---
<Base darkHero title="Terms & Conditions">
  <PageHero image={photos.glassTower} eyebrow="Legal" title="Terms &|conditions." />
  <section class="py-20 md:py-28">
    <div class="container-x">
      <div class="prose max-w-3xl">
        <p><strong>Placeholder.</strong> Replace with {site.legalName}'s terms and conditions reviewed by legal counsel.</p>
        <h2>Use of this website</h2>
        <p>The content of this website is provided for general information about {site.legalName}, its services and projects.</p>
        <h2>Intellectual property</h2>
        <p>Text, graphics, logos and images on this website are the property of {site.legalName} unless otherwise stated.</p>
        <h2>Contact</h2>
        <p>Questions about these terms can be sent through our <a href={u('/contact?topic=general#form')}>contact page</a>.</p>
      </div>
    </div>
  </section>
</Base>
