---
/**
 * ABOUT (documento): About Grascan Build · Our Approach (+ Our Commitment) · Our People · News & Insights
 */
import { u } from '@/lib/url';
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import SplitText from '@/components/SplitText.astro';
import Media from '@/components/Media.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import NewsCard from '@/components/NewsCard.astro';
import { photos } from '@/data/photos';
import { about, approach, commitment, people, aboutNewsCategories } from '@/data/services';

const news = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
---

<Base darkHero title="About" description={about.lead}>
  <PageHero image={photos.toronto} eyebrow="About Grascan Build" title="Built on experience.|Focused on|what comes next." accent={['next.']} lead={about.lead} />

  <!-- About Grascan Build (claro) -->
  <section id="about" class="scroll-mt-(--header-h) py-24 md:py-36">
    <div class="container-x grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-[calc(var(--header-h)+2rem)]">
          <Eyebrow class="mb-8 text-mute">About Grascan Build</Eyebrow>
          <div data-reveal="mask">
            <Media src={photos.cranes} alt="Tower cranes over a building under construction" class="aspect-[4/3]" />
          </div>
        </div>
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <div class="space-y-6 text-lg leading-relaxed text-ink/75" data-reveal>
          {about.paragraphs.map((p, i) => <p class:list={[i === 0 && 'text-lead text-ink']}>{p}</p>)}
        </div>
        <p class="mt-12 border-l-2 border-signal pl-6 font-wide text-[clamp(1.2rem,2vw,1.7rem)] leading-snug text-ink" data-reveal>{about.closing}</p>
      </div>
    </div>
  </section>

  <!-- Our Approach (gris) -->
  <section id="approach" class="scroll-mt-(--header-h) bg-concrete py-24 md:py-36">
    <div class="container-x">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <Eyebrow class="mb-8 text-mute">Our Approach</Eyebrow>
          <SplitText text="Built on experience.|Driven by execution." accent={['execution.']} class="font-wide text-title" />
        </div>
        <div class="space-y-4 text-ink/70 md:text-lg lg:col-span-5" data-reveal>
          {approach.intro.map((p) => <p>{p}</p>)}
        </div>
      </div>

      <ol class="mt-16 grid gap-px overflow-hidden border border-ink/10 bg-ink/10 md:mt-20 md:grid-cols-2 lg:grid-cols-4">
        {
          approach.steps.map((s, i) => (
            <li class="bg-bone p-8 md:p-10" data-reveal style={`--d:${i}`}>
              <p class="font-wide text-3xl text-gray">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="mt-6 font-wide text-2xl text-signal">{s.title}</h3>
              <p class="mt-5 font-semibold text-ink">{s.lead}</p>
              <p class="mt-3 text-ink/65">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Our Commitment (oscuro) -->
  <section class="on-dark bg-ink py-24 text-bone md:py-36">
    <div class="container-x">
      <SplitText text="Our Commitment" class="font-wide text-title" />
      <div class="mt-14 grid gap-px overflow-hidden bg-bone/12 md:mt-20 md:grid-cols-2 lg:grid-cols-3">
        {
          commitment.map((c, i) => (
            <article class="bg-ink p-8 md:p-10" data-reveal style={`--d:${i % 3}`}>
              <h3 class="font-wide text-xl">{c.title}.</h3>
              <p class="mt-4 text-bone/65">{c.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Our People (claro) -->
  <section id="people" class="scroll-mt-(--header-h) py-24 md:py-36">
    <div class="container-x">
      <div class="grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <Eyebrow class="mb-8 text-mute">Our People</Eyebrow>
          <SplitText text="Experienced people.|One team." accent={['team.']} class="font-wide text-title" />
          <div class="mt-10" data-reveal="mask">
            <Media src={photos.designBuild} alt="Project team reviewing a building model" class="aspect-[4/3]" />
          </div>
        </div>
        <div class="lg:col-span-6 lg:col-start-7">
          <p class="text-lead font-semibold text-ink" data-reveal>{people.lead}</p>
          <div class="mt-6 space-y-5 text-lg leading-relaxed text-ink/75" data-reveal style="--d:1">
            {people.paragraphs.map((p) => <p>{p}</p>)}
          </div>

          <h3 class="mt-14 font-semiwide text-xl font-bold text-signal" data-reveal>{people.drivenByTitle}</h3>
          <ul class="mt-5 grid border-t border-ink/10 sm:grid-cols-2 sm:gap-x-8" data-reveal style="--d:1">
            {
              people.drivenBy.map((v) => (
                <li class="flex items-center gap-3 border-b border-ink/10 py-3.5 font-medium text-ink">
                  <span class="size-2 shrink-0 bg-signal" aria-hidden="true"></span>
                  {v}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="on-dark bg-ink py-20 text-bone md:py-28">
    <div class="container-x flex flex-col items-start justify-between gap-10 md:flex-row md:items-end">
      <SplitText text={people.closing} accent={['teams.']} class="max-w-3xl font-wide text-title" />
      <div data-reveal style="--d:2"><Button href={u('/careers')}>Careers</Button></div>
    </div>
  </section>

  <!-- News & Insights (gris) -->
  <section id="news" class="scroll-mt-(--header-h) bg-concrete py-24 md:py-36">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-8">
        <div>
          <Eyebrow class="mb-8 text-mute">News & Insights</Eyebrow>
          <SplitText text="News & Insights" accent={['Insights']} class="font-wide text-title" />
        </div>
        <div data-reveal><Button href={u('/news')} variant="dark">Explore News & Insights</Button></div>
      </div>

      <ul class="mt-14 grid gap-px overflow-hidden border border-ink/10 bg-ink/10 sm:grid-cols-2 lg:grid-cols-4">
        {
          aboutNewsCategories.map((c, i) => (
            <li data-reveal style={`--d:${i}`}>
              <a href={u('/news')} class="group flex h-full items-center justify-between gap-4 bg-bone p-7 transition-colors hover:bg-concrete md:p-8">
                <span class="font-semiwide text-lg font-bold text-signal">{c}</span>
                <Icon name="arrow" class="size-4 shrink-0 text-signal transition-transform group-hover:translate-x-1" />
              </a>
            </li>
          ))
        }
      </ul>

      {news.length === 1 ? (
        <div class="mt-14"><NewsCard post={news[0]} feature /></div>
      ) : news.length > 1 && (
        <div class="mt-14 grid gap-12 sm:grid-cols-2 sm:gap-x-6 lg:grid-cols-3 lg:gap-8">
          {news.map((post, i) => <NewsCard post={post} index={i} />)}
        </div>
      )}
    </div>
  </section>
</Base>
