---
/**
 * WHY GRASCAN BUILD (documento): A Better Approach to Building · 01 Integrated Building & Civil ·
 * 02 Client Focused · 03 Lean & Hands On · 04 Trade & Subcontractor Network ·
 * 05 Our Competitive Advantage · Our Commitment. Formato documento (DocPage). Textos en src/data/sections.ts.
 */
import { u } from '@/lib/url';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import DocPage from '@/components/DocPage.astro';
import DocSection from '@/components/DocSection.astro';
import Button from '@/components/Button.astro';
import { whyIntro, whyItems, whyCommitment } from '@/data/sections';
import { photos, whyPhotos } from '@/data/photos';

const toc = [
  { id: 'overview', label: 'A Better Approach' },
  ...whyItems.map((w) => ({ id: w.slug, label: w.title, n: w.n })),
  { id: 'commitment', label: 'Our Commitment' },
];
---

<Base darkHero title="Why Grascan Build" description={whyIntro.paragraphs[0]}>
  <PageHero image={photos.curtainWall} eyebrow="Why Grascan Build" title="A Better Approach|to Building" accent={['Building']} lead={whyIntro.paragraphs[0]} />

  <DocPage toc={toc} label="Why Grascan Build">
    <DocSection id="overview" kicker="Overview" title="A Better Approach to Building" paragraphs={whyIntro.paragraphs.slice(1)} closing={whyIntro.closing}>
      <ol class="mt-12 grid gap-px overflow-hidden border border-fog bg-fog sm:grid-cols-2 lg:grid-cols-3" data-reveal>
        {
          whyItems.map((w) => (
            <li>
              <a href={`#${w.slug}`} class="group block h-full bg-bone p-5 transition-colors hover:bg-concrete">
                <span class="block font-wide text-xl text-steel">{w.n}</span>
                <span class="mt-2 block font-editorial text-sm tracking-normal text-ink">{w.title}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </DocSection>

    {
      whyItems.map((w) => (
        <DocSection id={w.slug} n={w.n} kicker="Why Grascan Build" title={w.title} subtitle={w.subtitle} paragraphs={w.paragraphs} closing={w.closing} image={whyPhotos[w.slug]}>
          {w.principles && (
            <ol class="mt-12 grid gap-px overflow-hidden border border-fog bg-fog sm:grid-cols-2">
              {w.principles.map((p, k) => (
                <li class="bg-bone p-6" data-reveal style={`--d:${k % 2}`}>
                  <h3 class="font-editorial text-base tracking-normal">{p.title}</h3>
                  <p class="mt-3 text-sm leading-relaxed text-ink/75">{p.text}</p>
                </li>
              ))}
            </ol>
          )}
        </DocSection>
      ))
    }

    <DocSection id="commitment" kicker="Our Commitment" title="A Construction Partner Focused on What Matters." paragraphs={whyCommitment.paragraphs} closing={whyCommitment.closing}>
      <div class="mt-10" data-reveal><Button href={u('/contact?topic=project#form')}>Start a project</Button></div>
    </DocSection>
  </DocPage>
</Base>
