---
/**
 * HEALTH & SAFETY (documento): Safety Is Fundamental to How We Build · Our Approach to Safety
 * (1 COR / ISO 45001 · 2 Safety & Emergency Preparedness · 3 Employee Safety Portal ·
 * 4 Subcontractor Safety · 5 Construction Site Safety · 6 Environmental & Hazard Management ·
 * 7 Grascan Build Policies & Resources) · A Commitment Shared by Everyone.
 * Formato documento (DocPage). Textos en src/data/sections.ts.
 */
import { u } from '@/lib/url';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import DocPage from '@/components/DocPage.astro';
import DocSection from '@/components/DocSection.astro';
import Button from '@/components/Button.astro';
import { healthSafety as hs } from '@/data/sections';
import { photos } from '@/data/photos';

const n = (i: number) => String(i + 1).padStart(2, '0');
const toc = [
  { id: 'overview', label: 'Overview' },
  ...hs.sections.map((s, i) => ({ id: s.id, label: s.title, n: n(i) })),
  { id: 'shared', label: 'A Commitment Shared by Everyone' },
];
---

<Base darkHero title="Health & Safety" description={hs.intro[0]}>
  <PageHero image={photos.facadeCrew} eyebrow="Health & Safety" title="Safety Is Fundamental|to How We Build." accent={['Build.']} lead={hs.intro[0]} />

  <DocPage toc={toc} label="Health & Safety">
    <DocSection id="overview" kicker="Overview" title="Safety Is Fundamental to How We Build." paragraphs={hs.intro.slice(1)} closing={hs.principle} image={photos.trackCrew} imageAlt="Crew in high-visibility safety equipment working on site at night">
      <ol class="mt-12 grid gap-px overflow-hidden border border-fog bg-fog sm:grid-cols-2" data-reveal>
        {
          hs.sections.map((s, i) => (
            <li class="sm:[&:last-child:nth-child(odd)]:col-span-2">
              <a href={`#${s.id}`} class="flex h-full gap-4 bg-bone p-5 transition-colors hover:bg-concrete">
                <span class="w-6 shrink-0 font-wide text-steel">{n(i)}</span>
                <span class="font-editorial text-sm tracking-normal text-ink">{s.title}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </DocSection>

    {hs.sections.map((s, i) => <DocSection id={s.id} n={n(i)} kicker="Our Approach to Safety" title={s.title} subtitle={s.subtitle} paragraphs={s.paragraphs} />)}

    <DocSection id="shared" kicker="Health & Safety" title="A Commitment Shared by Everyone" paragraphs={hs.shared.paragraphs} closing={hs.shared.closing}>
      <div class="mt-10" data-reveal><Button href={u('/contact?topic=safety#form')}>Contact our team</Button></div>
    </DocSection>
  </DocPage>
</Base>
