---
/**
 * SERVICES (documento): introducción · General Contracting · Construction Management · Design-Build ·
 * Alternative Project Delivery (Progressive Design-Build · Integrated Project Delivery · Custom Alternative Approaches) ·
 * Pre-Construction Planning. Formato documento (DocPage): índice fijo y una sección por servicio.
 */
import { u } from '@/lib/url';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import DocPage from '@/components/DocPage.astro';
import DocSection from '@/components/DocSection.astro';
import Button from '@/components/Button.astro';
import { services, servicesIntro, contactCopy } from '@/data/services';
import { photos, servicePhotos } from '@/data/photos';

const n = (i: number) => String(i + 1).padStart(2, '0');
const toc = [{ id: 'overview', label: 'Overview' }, ...services.map((s, i) => ({ id: s.slug, label: s.title, n: n(i) }))];
---

<Base darkHero title="Services" description={servicesIntro.lead}>
  <PageHero image={photos.facadeDusk} eyebrow="Services" title="Construction expertise|from planning|through completion" accent={['completion']} lead={servicesIntro.lead} />

  <DocPage toc={toc} label="Services">
    <DocSection id="overview" kicker="Overview" title="Our Services" paragraphs={servicesIntro.paragraphs}>
      <!-- Resumen: los cinco servicios de un vistazo -->
      <ol class="mt-12 grid gap-px overflow-hidden border border-fog bg-fog sm:grid-cols-2" data-reveal>
        {
          services.map((s, i) => (
            <li class="sm:[&:last-child:nth-child(odd)]:col-span-2">
              <a href={`#${s.slug}`} class="group block h-full bg-bone p-6 transition-colors hover:bg-concrete">
                <span>
                  <span class="block text-xs font-semibold tracking-[0.2em] text-signal-ink">{n(i)}</span>
                  <span class="mt-1 block font-editorial text-base tracking-normal text-ink">{s.title}</span>
                  <span class="mt-1 block text-sm text-mute">{s.subtitle}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </DocSection>

    {
      services.map((s, i) => (
        <DocSection id={s.slug} n={n(i)} kicker="Services" title={s.title} subtitle={s.subtitle} paragraphs={s.paragraphs} closing={s.closing} image={servicePhotos[s.slug]} imageAlt={s.title}>
          {s.approaches && (
            <div class="mt-12 grid gap-px overflow-hidden border border-fog bg-fog md:grid-cols-3">
              {s.approaches.map((a, k) => (
                <article id={a.slug} class="scroll-mt-[calc(var(--header-h)+5rem)] bg-bone p-6 md:p-7" data-reveal style={`--d:${k}`}>
                  <h3 class="font-editorial text-base tracking-normal text-ink">{a.title}</h3>
                  <div class="mt-4 space-y-3 text-sm leading-relaxed text-ink/75">
                    {a.paragraphs.map((p) => <p>{p}</p>)}
                  </div>
                </article>
              ))}
            </div>
          )}

          {s.list && (
            <div class="mt-12" data-reveal>
              <h3 class="eyebrow text-signal-ink">{s.list.title}</h3>
              <ul class="mt-5 grid border-t border-fog sm:grid-cols-2 sm:gap-x-8">
                {s.list.items.map((c) => (
                  <li class="flex items-center gap-3 border-b border-fog py-3.5 text-ink">
                    <span class="size-1.5 shrink-0 bg-steel" aria-hidden="true"></span>
                    {c}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </DocSection>
      ))
    }
  </DocPage>

  <section class="on-dark bg-ink py-24 text-bone md:py-32">
    <div class="container-x flex flex-col items-start justify-between gap-10 md:flex-row md:items-end">
      <div class="max-w-3xl">
        <h2 class="font-editorial text-title" data-reveal>{contactCopy.start.lead}</h2>
        <p class="mt-6 text-bone/70 md:text-lg" data-reveal style="--d:1">{contactCopy.start.text}</p>
      </div>
      <div data-reveal style="--d:2"><Button href={u('/contact?topic=project#form')}>Start a project</Button></div>
    </div>
  </section>
</Base>
