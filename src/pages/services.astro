---
/** SERVICES: los 12 servicios de la estructura del documento, en su orden. */
import { u } from '@/lib/url';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import ServiceIcon from '@/components/ServiceIcon.astro';
import Media from '@/components/Media.astro';
import SplitText from '@/components/SplitText.astro';
import Button from '@/components/Button.astro';
import { services, whatWeDo, contactCopy } from '@/data/services';
import type { BlueprintVariant } from '@/lib/blueprint';

// Ilustración de placeholder por servicio (sólo tipologías de edificación)
const art: BlueprintVariant[] = ['tower', 'midrise', 'warehouse', 'campus', 'midrise', 'tower', 'campus', 'midrise', 'midrise', 'campus', 'tower', 'road'];
---

<Base title="Services" description={`${services.map((s) => s.title).join(', ')}. ${whatWeDo.intro[0]}`}>
  <PageHero eyebrow="Services" title="From planning|to completion." accent={['completion.']} lead={whatWeDo.intro[0]}>
    <p class="mt-6 max-w-2xl text-ink/70" data-reveal style="--d:4">{whatWeDo.intro[1]}</p>
    <nav aria-label="Services" class="mt-12 grid max-w-4xl border-t border-ink/10 sm:grid-cols-2 lg:grid-cols-3" data-reveal style="--d:5">
      {services.map((s) => <a href={`#${s.slug}`} class="border-b border-ink/10 py-3 pr-4 font-semibold text-ink/80 transition-colors hover:text-signal">{s.title}</a>)}
    </nav>
  </PageHero>

  {
    services.map((s, i) => {
      const flip = i % 2 === 1;
      return (
        <section id={s.slug} class:list={['scroll-mt-24 py-16 md:py-28', i % 2 === 1 && 'bg-concrete']}>
          <div class="container-x grid gap-12 lg:grid-cols-12 lg:items-center">
            <div class:list={['lg:col-span-6', flip && 'lg:order-2 lg:col-start-7']}>
              <div data-reveal>
                <ServiceIcon name={s.icon} class="size-14 text-signal" />
              </div>
              <SplitText as="h2" text={s.title} class="mt-6 font-wide text-title" />
              {s.tagline && <p class="mt-5 text-lg font-semibold text-signal-ink" data-reveal style="--d:1">{s.tagline}</p>}
              <p class="mt-5 max-w-xl text-lead text-ink/70" data-reveal style="--d:2">{s.text}</p>
              {s.scope && (
                <ul class="mt-10 grid gap-x-8 sm:grid-cols-2" data-reveal style="--d:3">
                  {s.scope.map((c) => (
                    <li class="flex items-center gap-3 border-b border-ink/10 py-3.5">
                      <span class="size-2 shrink-0 bg-signal" aria-hidden="true"></span>
                      {c}
                    </li>
                  ))}
                </ul>
              )}
            </div>
            <div class:list={['lg:col-span-5', flip ? 'lg:order-1 lg:col-start-1' : 'lg:col-start-8']} data-reveal="mask">
              <Media seed={`service-${s.slug}`} variant={art[i]} class="aspect-[4/3] sm:aspect-[16/10] lg:aspect-[4/5]" tone={i % 2 ? 'dark' : 'light'} />
            </div>
          </div>
        </section>
      );
    })
  }

  <section class="on-dark bg-ink py-24 text-bone md:py-32">
    <div class="container-x flex flex-col items-start justify-between gap-10 md:flex-row md:items-end">
      <div class="max-w-3xl">
        <h2 class="font-wide text-title" data-reveal>{contactCopy.start.lead}</h2>
        <p class="mt-6 text-bone/70" data-reveal style="--d:1">{contactCopy.start.text}</p>
      </div>
      <div data-reveal style="--d:2"><Button href={u('/contact?topic=project#form')}>Start a project</Button></div>
    </div>
  </section>
</Base>
