---
import { u } from '@/lib/url';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import { site } from '@/site.config';
import { photos } from '@/data/photos';
---
<Base darkHero title="Privacy Policy">
  <PageHero image={photos.glassTower} eyebrow="Legal" title="Privacy policy." />
  <section class="py-20 md:py-28">
    <div class="container-x">
      <div class="prose max-w-3xl">
        <p><strong>Placeholder.</strong> Replace with {site.legalName}'s privacy policy reviewed by legal counsel.</p>
        <h2>Information we collect</h2>
        <p>Information you submit through our contact form, such as your name, company, email address, phone number and project details.</p>
        <h2>How we use it</h2>
        <ul><li>To respond to your inquiry</li><li>To connect you with the appropriate construction and project-delivery professionals</li><li>To improve our website</li></ul>
        <h2>Contact</h2>
        <p>Questions about this policy can be sent through our <a href={u('/contact?topic=general#form')}>contact page</a>.</p>
      </div>
    </div>
  </section>
</Base>
