---
/**
 * MARKETS (documento): intro · 01 Institutional · 02 Commercial · 03 Industrial ·
 * 04 Multi-Unit Residential · 05 Transit · Our Approach · Building with purpose.
 * Formato documento (DocPage). Textos en src/data/sections.ts.
 */
import { u } from '@/lib/url';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import DocPage from '@/components/DocPage.astro';
import DocSection from '@/components/DocSection.astro';
import ServiceIcon from '@/components/ServiceIcon.astro';
import Button from '@/components/Button.astro';
import { markets } from '@/data/services';
import { marketsPage, marketDetails, marketsApproach, buildingWithPurpose } from '@/data/sections';
import { photos, marketPhotos } from '@/data/photos';

const n = (i: number) => String(i + 1).padStart(2, '0');
const toc = [
  { id: 'overview', label: 'Overview' },
  ...markets.map((m, i) => ({ id: m.slug, label: m.title, n: n(i) })),
  { id: 'approach', label: 'Our Approach' },
  { id: 'purpose', label: 'Building with purpose' },
];
---

<Base darkHero title="Markets" description={marketsPage.intro[0]}>
  <PageHero image={photos.twinTowers} eyebrow="Markets" title="Building for the Needs|of Today and the|Demands of Tomorrow" accent={['Tomorrow']} lead={marketsPage.intro[0]} />

  <DocPage toc={toc} label="Markets">
    <DocSection id="overview" kicker="Overview" title="Our Markets" paragraphs={marketsPage.intro.slice(1)} closing={marketsPage.closing}>
      <ol class="mt-12 grid gap-px overflow-hidden border border-fog bg-fog sm:grid-cols-2 lg:grid-cols-3" data-reveal>
        {
          markets.map((m, i) => (
            <li>
              <a href={`#${m.slug}`} class="group flex h-full items-center gap-4 bg-bone p-5 transition-colors hover:bg-concrete">
                <ServiceIcon name={m.icon} class="size-8 shrink-0 text-steel" />
                <span>
                  <span class="block text-xs font-semibold tracking-[0.2em] text-signal-ink">{n(i)}</span>
                  <span class="mt-0.5 block font-editorial text-sm tracking-normal text-ink">{m.title}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </DocSection>

    {
      markets.map((m, i) => {
        const d = marketDetails[m.slug];
        return <DocSection id={m.slug} n={n(i)} kicker="Markets" title={m.title} subtitle={d.subtitle} paragraphs={d.paragraphs} closing={d.closing} image={marketPhotos[m.slug]} imageAlt={m.title} />;
      })
    }

    <DocSection id="approach" kicker="Our Approach" title="A Consistent Standard Across Every Market" paragraphs={[marketsApproach.intro]}>
      <ol class="mt-12 grid gap-px overflow-hidden border border-fog bg-fog sm:grid-cols-2">
        {
          marketsApproach.principles.map((p, i) => (
            <li class="bg-bone p-6 md:p-7 sm:[&:last-child:nth-child(odd)]:col-span-2" data-reveal style={`--d:${i % 2}`}>
              <p class="font-wide text-2xl text-steel">{n(i)}</p>
              <h3 class="mt-4 font-editorial text-base tracking-normal">{p.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink/75">{p.text}</p>
            </li>
          ))
        }
      </ol>
      <p class="mt-10 font-editorial text-[clamp(0.95rem,1.5vw,1.2rem)] tracking-[0.04em] text-signal-ink" data-reveal>{marketsApproach.tagline}</p>
    </DocSection>

    <DocSection id="purpose" kicker="Building with purpose" title="Building with purpose." paragraphs={buildingWithPurpose.paragraphs} closing={buildingWithPurpose.closing}>
      <div class="mt-10 flex flex-wrap gap-3" data-reveal>
        <Button href={u('/contact?topic=project#form')}>Start a project</Button>
        <Button href={u('/why-grascan-build')} variant="ghost">Why Grascan Build</Button>
      </div>
    </DocSection>
  </DocPage>
</Base>
