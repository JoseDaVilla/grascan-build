---
/**
 * MARKETS: Institutional · Commercial · Industrial · Multi-Unit Residential · Transit.
 * TODO (cliente): el documento aún no tiene texto propio para cada mercado; mientras tanto se usa
 * el texto de "What We Build" (Home). Cuando llegue, añadir el texto de cada uno en `markets` (src/data/services.ts).
 */
import { u } from '@/lib/url';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import ServiceIcon from '@/components/ServiceIcon.astro';
import Media from '@/components/Media.astro';
import Button from '@/components/Button.astro';
import { markets, whatWeBuild, contactCopy } from '@/data/services';
import { photos, marketPhotos } from '@/data/photos';
---

<Base darkHero title="Markets" description={whatWeBuild.intro[0]}>
  <PageHero image={photos.transit} eyebrow="Markets" title="Building for the|demands of today.|Preparing for|what comes next." accent={['next.']} lead={whatWeBuild.intro[0]} />

  <section class="py-20 md:py-28">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="space-y-6 text-lg leading-relaxed text-ink/75 lg:col-span-7" data-reveal>
        {whatWeBuild.intro.slice(1).map((p) => <p>{p}</p>)}
      </div>
    </div>

    <ul class="container-x mt-16 grid gap-5 md:mt-20 md:grid-cols-2 lg:grid-cols-6">
      {
        markets.map((m, i) => (
          <li id={m.slug} class:list={['scroll-mt-(--header-h)', i < 2 ? 'lg:col-span-3' : 'lg:col-span-2']} data-reveal style={`--d:${i % 3}`}>
            <div class="on-dark relative overflow-hidden bg-ink text-bone">
              <Media src={marketPhotos[m.slug]} alt={m.title} class="aspect-[4/3]" sizes="(min-width: 1024px) 50vw, (min-width: 768px) 50vw, 100vw" />
              <div class="absolute inset-0 bg-[linear-gradient(0deg,rgb(4_31_66/0.9)_0%,rgb(4_31_66/0.2)_60%,transparent_100%)]"></div>
              <div class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 p-6 md:p-8">
                <h2 class="font-wide text-[clamp(1.2rem,2vw,1.7rem)] leading-tight">{m.title}</h2>
                <ServiceIcon name={m.icon} class="size-10 shrink-0 text-bone/80" />
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="on-dark bg-ink py-24 text-bone md:py-32">
    <div class="container-x flex flex-col items-start justify-between gap-10 md:flex-row md:items-end">
      <div class="max-w-3xl">
        <h2 class="font-wide text-title" data-reveal>{contactCopy.start.lead}</h2>
        <p class="mt-6 text-bone/70 md:text-lg" data-reveal style="--d:1">{contactCopy.start.text}</p>
      </div>
      <div data-reveal style="--d:2"><Button href={u('/contact?topic=project#form')}>Start a project</Button></div>
    </div>
  </section>
</Base>
