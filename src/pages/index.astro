---
/**
 * HOME — secciones en el orden del documento "STRUCTURE WEBSITE: GRASCAN BUILD":
 * Hero · texto del hero + statement · Built on experience · Our Foundation · A new chapter ·
 * Building on experience · What We Build · What We Do (Our Capabilities) · Where We Build ·
 * Featured Projects · Safety & Quality · News & Insights · Contact / Offices
 */
import { u } from '@/lib/url';
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import SplitText from '@/components/SplitText.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Button from '@/components/Button.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import NewsCard from '@/components/NewsCard.astro';
import ServiceIcon from '@/components/ServiceIcon.astro';
import ContactBlock from '@/components/ContactBlock.astro';
import Media from '@/components/Media.astro';
import Icon from '@/components/Icon.astro';
import { photos, marketPhotos } from '@/data/photos';
import {
  heroCopy,
  story,
  foundation,
  newChapter,
  buildingOnExperience as boe,
  whatWeBuild,
  markets,
  capabilities,
  whereWeBuild,
  projectsCopy,
  safety,
  safetyTopics,
  newsCopy,
  newsCategories,
  contactCopy,
} from '@/data/services';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured).slice(0, 3);
const news = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const safetyList = Object.values(safetyTopics);
---

<Base intro heroLogo>
  <Hero />

  <!--
    Home en franjas: blanco · azul claro · edificio de fondo (capa navy), en ese ritmo.
    Textos alineados a la izquierda; algunos titulares a la derecha y escalas distintas (title · display · mega).
    Animaciones: textos que suben (data-reveal / SplitText), fotos que se revelan con zoom (zoom-in)
    y fondos con parallax.
  -->

  <!-- 1 · BLANCO — Texto del hero (documento): frase centrada y texto en dos columnas -->
  <section id="intro-statement" class="scroll-mt-(--header-h) bg-bone py-24 md:py-36">
    <div class="container-x">
      <p class="eyebrow text-signal-ink" data-reveal>Buildings & Development</p>
      <p class="mt-6 max-w-5xl font-editorial text-[clamp(1.6rem,3.4vw,3.1rem)] leading-[1.06] text-ink" data-reveal style="--d:1">{heroCopy.lead}</p>
      <span class="mt-12 block h-px w-16 bg-steel" aria-hidden="true"></span>
      <div class="mt-12 grid max-w-6xl gap-8 leading-relaxed text-ink/70 md:grid-cols-2 md:gap-x-14 md:text-lg [&_strong]:font-semibold [&_strong]:text-ink" data-reveal style="--d:2">
        {heroCopy.paragraphs.map((p, i) => <p class:list={[i === 0 && 'text-lead text-ink/85 md:col-span-2 md:max-w-4xl']} set:html={p} />)}
      </div>
      <div class="mt-12 flex flex-wrap gap-3" data-reveal style="--d:3">
        <Button href={u('/contact?topic=project#form')}>Start a project</Button>
        <Button href={u('/services')} variant="ghost">Our services</Button>
      </div>
    </div>
  </section>

  <!-- 3 · EDIFICIO — Built on experience: titular a la izquierda sobre fachada de vidrio -->
  <section id="experience" class="on-dark relative scroll-mt-(--header-h) overflow-hidden bg-ink pt-28 pb-36 text-bone md:py-40">
    <Media src={photos.glassFacade} alt="" class="absolute inset-0" imgClass="parallax" sizes="100vw" />
    <div class="absolute inset-0 bg-ink/80"></div>
    <div class="container-x relative">
      <SplitText text="Built on experience.|Focused on what|comes next." accent={['next.']} class="max-w-5xl font-editorial text-display" />
      <div class="mt-14 grid gap-10 md:mt-20 lg:grid-cols-12">
        <div class="space-y-6 text-lg leading-relaxed text-bone/80 lg:col-span-6 lg:col-start-7" data-reveal>
          {story.paragraphs.map((p) => <p>{p}</p>)}
          <p class="border-t border-bone/20 pt-6 font-semiwide text-xl text-bone">{story.proposition}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 · BLANCO — Our Foundation: título a la izquierda y los cuatro pilares como lista ordenada -->
  <section id="foundation" class="bg-bone py-24 md:py-36">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-[calc(var(--header-h)+2.5rem)]">
          <p class="eyebrow text-signal-ink" data-reveal>Grascan Build</p>
          <h2 class="mt-5 font-editorial text-title" data-reveal>Our Foundation</h2>
          <span class="mt-8 block h-0.5 w-10 bg-steel" aria-hidden="true"></span>
        </div>
      </div>
      <ol class="border-b border-fog lg:col-span-8">
        {
          foundation.map((f, i) => (
            <li class="grid grid-cols-[3rem_1fr] gap-x-5 border-t border-fog py-8 md:grid-cols-[4.5rem_13rem_1fr] md:gap-x-8 md:py-10" data-reveal style={`--d:${i}`}>
              <p class="font-wide text-2xl leading-none text-steel md:text-3xl">{f.n}</p>
              <h3 class="font-semiwide text-xl uppercase leading-tight text-ink md:text-2xl">{f.title}</h3>
              <div class="col-start-2 mt-3 md:col-start-3 md:mt-0">
                <p class="text-ink md:text-lg">{f.lead}</p>
                {f.detail && <p class="mt-2 text-sm leading-relaxed text-mute md:text-base">{f.detail}</p>}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 5 · STEEL BLUE — A new chapter: titular a la derecha, foto panorámica, texto en dos columnas -->
  <section class="on-steel py-24 md:py-36">
    <div class="container-x">
      <SplitText text="A new chapter|in the Grascan story" accent={['story']} class="font-editorial text-display lg:text-right" />
      <div class="mt-12 md:mt-16" data-reveal="mask">
        <Media src={photos.torontoNight} alt="Grascan night works along the Toronto waterfront" class="aspect-[4/3] md:aspect-[21/9]" imgClass="zoom-in object-[50%_40%]" sizes="100vw" />
      </div>
      <div class="mt-12 grid gap-8 text-ink/85 md:grid-cols-2 md:gap-14 md:text-lg [&_strong]:font-semibold [&_strong]:text-ink" data-reveal>
        {newChapter.paragraphs.map((p, i) => <p class:list={[i === 0 && 'font-semiwide text-[clamp(1.35rem,2.2vw,1.9rem)] leading-snug text-ink']} set:html={p} />)}
      </div>
    </div>
  </section>

  <!-- 6 · EDIFICIO — Building on experience: titular gigante centrado -->
  <section class="on-dark relative overflow-hidden bg-ink py-32 text-bone md:py-48">
    <Media src={photos.curvedTower} alt="" class="absolute inset-0" imgClass="parallax" sizes="100vw" />
    <div class="absolute inset-0 bg-ink/75"></div>
    <div class="container-x relative">
      <SplitText text="Building on|experience." accent={['experience.']} class="font-editorial text-mega" />
      <p class="mt-10 max-w-3xl text-lead text-bone/85" data-reveal style="--d:2">{boe.text}</p>
    </div>
  </section>

  <!-- 7 · BLANCO — What We Build: titular a la izquierda, texto a la derecha, tarjetas escalonadas -->
  <section id="what-we-build" class="scroll-mt-(--header-h) bg-bone py-24 md:py-36">
    <div class="container-x">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <Eyebrow class="mb-6 text-signal-ink">What We Build</Eyebrow>
          <SplitText text="Building for the|demands of today.|Preparing for|what comes next." accent={['next.']} class="font-editorial text-title" />
        </div>
        <div class="space-y-5 leading-relaxed text-ink/70 md:text-lg lg:col-span-4 lg:col-start-9" data-reveal>
          {whatWeBuild.intro.map((p, i) => <p class:list={[i === 0 && 'font-semibold text-ink']}>{p}</p>)}
        </div>
      </div>

      <ul class="mt-16 grid gap-x-5 gap-y-10 sm:grid-cols-2 md:mt-20 lg:grid-cols-5">
        {
          markets.map((m, i) => (
            <li data-reveal style={`--d:${i}`} class:list={[i % 2 === 1 && 'lg:mt-16']}>
              <a href={u(`/markets#${m.slug}`)} class="group block">
                <Media src={marketPhotos[m.slug]} alt={m.title} class="aspect-[4/3] lg:aspect-[3/4]" imgClass="zoom-in" sizes="(min-width: 1024px) 20vw, (min-width: 640px) 50vw, 100vw" />
                <div class="flex items-center justify-between gap-3 border-b border-fog py-5">
                  <h3 class="font-editorial text-base tracking-normal text-ink">{m.title}</h3>
                  <Icon name="arrow" class="size-4 shrink-0 text-steel transition-transform group-hover:translate-x-1" />
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 8 · STEEL BLUE — Our Capabilities: titular gigante centrado y lista -->
  <section id="what-we-do" class="on-steel scroll-mt-(--header-h) py-24 md:py-36">
    <div class="container-x">
      <p class="eyebrow text-ink" data-reveal>What We Do</p>
      <SplitText text="Our Capabilities" accent={['Capabilities']} class="mt-6 font-editorial text-mega" />

      <ul class="mt-16 border-t border-ink/20 md:mt-24">
        {
          capabilities.map((s, i) => (
            <li data-reveal style={`--d:${i % 3}`}>
              <a href={u(`/services#${s.slug}`)} class="group grid grid-cols-[auto_1fr] gap-5 border-b border-ink/20 py-7 transition-colors hover:bg-bone/10 md:grid-cols-[auto_minmax(0,5fr)_minmax(0,6fr)] md:gap-10 md:px-4 md:py-9">
                <ServiceIcon name={s.icon} class="size-11 text-ink md:size-12" />
                <span class="block self-center font-editorial text-[clamp(1.15rem,2vw,1.7rem)] leading-tight transition-transform duration-500 ease-(--ease-expo) group-hover:translate-x-2">{s.title}</span>
                <span class="col-span-2 self-center text-ink/80 md:col-span-1 md:text-lg">{s.text}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-12" data-reveal><Button href={u('/services')} variant="dark">All services</Button></div>
    </div>
  </section>

  <!-- 9 · EDIFICIO — Where We Build: texto a la izquierda sobre torres -->
  <section id="where-we-build" class="on-dark relative overflow-hidden bg-ink pt-28 pb-36 text-bone md:py-40">
    <Media src={photos.officeTowers} alt="" class="absolute inset-0" imgClass="parallax" sizes="100vw" />
    <div class="absolute inset-0 bg-gradient-to-r from-ink/95 via-ink/80 to-ink/40"></div>
    <div class="container-x relative">
      <div class="max-w-2xl">
        <SplitText text="Where|We Build" accent={['Build']} class="font-editorial text-display" />
        <div class="mt-8 space-y-5 leading-relaxed text-bone/80 md:text-lg" data-reveal style="--d:2">
          {whereWeBuild.paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <p class="mt-8 border-l-2 border-steel pl-6 font-semiwide text-xl text-bone" data-reveal style="--d:3">{whereWeBuild.closing}</p>
      </div>
    </div>
  </section>

  <!-- 10 · BLANCO — Featured Projects: titular gigante a la izquierda. Sin proyectos: collage de altura fija en escritorio -->
  <section id="projects" class="scroll-mt-(--header-h) bg-bone py-24 md:py-36">
    <div class="container-x">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <SplitText text="Featured|Projects" accent={['Projects']} class="font-editorial text-mega" />
        </div>
        <div class="text-ink/70 md:text-lg lg:col-span-4 [&_strong]:text-ink" data-reveal>
          <p set:html={projectsCopy.intro} />
        </div>
      </div>

      {
        featured.length > 0 ? (
          <div class="mt-16 grid gap-x-8 gap-y-16 md:mt-20 md:grid-cols-3">
            {featured.map((p, i) => <ProjectCard project={p} index={i} />)}
          </div>
        ) : (
          <div class="mt-16 grid gap-4 md:mt-20 md:h-[min(60vh,32rem)] md:grid-cols-12 md:grid-rows-2" data-reveal="mask">
            <Media src={photos.residentialHighrise} alt="Multi-unit residential tower" class="aspect-[16/10] md:col-span-7 md:row-span-2 md:aspect-auto md:h-full" imgClass="zoom-in object-[50%_35%]" sizes="(min-width: 768px) 58vw, 100vw" />
            <Media src={photos.industrialFacility} alt="Industrial facility" class="aspect-[16/10] md:col-span-5 md:aspect-auto md:h-full" imgClass="zoom-in" sizes="(min-width: 768px) 42vw, 100vw" />
            <Media src={photos.institutionalCampus} alt="Institutional building" class="aspect-[16/10] md:col-span-5 md:aspect-auto md:h-full" imgClass="zoom-in" sizes="(min-width: 768px) 42vw, 100vw" />
          </div>
        )
      }

      <div class="mt-12 grid gap-8 md:grid-cols-12 md:items-end" data-reveal>
        <div class="md:col-span-7">
          <h3 class="font-editorial text-xl tracking-normal">{projectsCopy.ourProjects.title}</h3>
          <p class="mt-4 max-w-2xl text-ink/70">{projectsCopy.ourProjects.text}</p>
        </div>
        <div class="md:col-span-5 md:text-right">
          <a href={u('/projects')} class="inline-flex items-center gap-2 font-semibold uppercase tracking-wide text-ink"><span class="link-u">Explore All Projects</span><Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- 11 · STEEL BLUE — Safety & Quality: centrado, foto panorámica, temas en rejilla -->
  <section id="safety" class="on-steel py-24 md:py-36">
    <div class="container-x">
      <p class="eyebrow text-ink" data-reveal>Safety & quality</p>
      <SplitText text="Safety is|how we build." accent={['build.']} class="mt-6 font-editorial text-display" />
      <div class="mt-10 max-w-3xl space-y-4 text-ink/85 md:text-lg" data-reveal>
        {safety.intro.map((p) => <p>{p}</p>)}
      </div>
      <div class="mt-14 md:mt-20" data-reveal="mask">
        <Media src={photos.interiorFitout} alt="Site team in safety equipment inside a building under construction" class="aspect-[4/3] md:aspect-[21/9]" imgClass="zoom-in" sizes="100vw" />
      </div>

      <ul class="mt-px grid gap-px overflow-hidden bg-ink/15 md:grid-cols-2 lg:grid-cols-4">
        {
          safetyList.map((t, i) => (
            <li class="bg-sky p-8" data-reveal style={`--d:${i % 4}`}>
              <h3 class="font-editorial text-base tracking-normal">{t.title}</h3>
              {'lead' in t && <p class="mt-4 font-semibold text-ink">{t.lead}</p>}
              <p class="mt-3 text-sm text-ink/80">{t.text}</p>
            </li>
          ))
        }
        <li class="on-dark flex flex-col justify-between gap-8 bg-ink p-8">
          <p class="font-editorial text-2xl text-bone">{safety.closing}</p>
          <a href={u('/health-safety')} class="inline-flex items-center gap-2 font-semibold uppercase tracking-wide text-bone"><span class="link-u">Health & Safety</span><Icon name="arrow" /></a>
        </li>
      </ul>
    </div>
  </section>

  <!-- 12 · BLANCO — News & Insights: titular a la derecha, texto a la izquierda -->
  <section id="news" class="bg-bone py-24 md:py-36">
    <div class="container-x">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7 lg:col-start-6 lg:row-start-1 lg:text-right">
          <Eyebrow class="mb-6 text-signal-ink">News & insights</Eyebrow>
          <SplitText text="Perspectives from|the people building|what's next." accent={["next."]} class="font-editorial text-title" />
        </div>
        <div class="space-y-4 text-ink/70 lg:col-span-4 lg:col-start-1 lg:row-start-1" data-reveal>
          {newsCopy.intro.map((p) => <p>{p}</p>)}
        </div>
      </div>

      <ul class="mt-16 grid border-t border-fog sm:grid-cols-2 lg:grid-cols-5 md:mt-20">
        {
          newsCategories.map((c, i) => (
            <li class="border-b border-fog py-7 sm:pr-6 lg:border-l lg:px-6 lg:first:border-l-0 lg:first:pl-0" data-reveal style={`--d:${i}`}>
              <h3 class="font-semiwide text-lg text-ink">{c.title}</h3>
              <p class="mt-2 text-sm text-mute">{c.text}</p>
            </li>
          ))
        }
      </ul>

      {
        news.length === 1 ? (
          <div class="mt-16"><NewsCard post={news[0]} feature /></div>
        ) : news.length > 1 && (
          <div class="mt-16 grid gap-12 sm:grid-cols-2 sm:gap-x-6 lg:grid-cols-3 lg:gap-8">
            {news.map((post, i) => <NewsCard post={post} index={i} />)}
          </div>
        )
      }
      <div class="mt-12" data-reveal>
        <a href={u('/news')} class="inline-flex items-center gap-2 font-semibold uppercase tracking-wide text-ink"><span class="link-u">Explore News & Insights</span><Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- 13 · EDIFICIO — Contact: titular gigante centrado sobre edificio y tarjetas de contacto -->
  <section id="contact" class="relative overflow-hidden bg-ink py-24 md:py-36">
    <Media src={photos.twinTowers} alt="" class="absolute inset-0" imgClass="parallax" sizes="100vw" />
    <div class="absolute inset-0 bg-ink/85"></div>
    <div class="container-x relative">
      <!-- on-dark sólo en el texto: las tarjetas de contacto mantienen sus colores sobre blanco -->
      <div class="on-dark">
      <p class="eyebrow text-bone/70" data-reveal>Contact</p>
      <SplitText text="Let's build|what's next." accent={["next."]} class="mt-6 font-editorial text-mega" />
      <div class="mt-10 max-w-2xl space-y-4 text-bone/80 md:text-lg [&_strong]:text-bone" data-reveal>
        {contactCopy.intro.map((p) => <p set:html={p} />)}
      </div>
      </div>
      <div class="mt-16 md:mt-24"><ContactBlock /></div>
    </div>
  </section>
</Base>
