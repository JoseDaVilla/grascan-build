---
/**
 * HOME — secciones en el orden del documento "STRUCTURE WEBSITE: GRASCAN BUILD":
 * Hero · texto del hero + statement · Built on experience · Our Foundation · A new chapter ·
 * Building on experience · What We Build · What We Do (Our Capabilities) · Where We Build ·
 * Featured Projects · Safety & Quality · News & Insights · Contact / Offices
 */
import { u } from '@/lib/url';
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import SplitText from '@/components/SplitText.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Button from '@/components/Button.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import NewsCard from '@/components/NewsCard.astro';
import ServiceIcon from '@/components/ServiceIcon.astro';
import ContactBlock from '@/components/ContactBlock.astro';
import Media from '@/components/Media.astro';
import Icon from '@/components/Icon.astro';
import { photos, marketPhotos } from '@/data/photos';
import { highlights } from '@/site.config';
import {
  heroCopy,
  story,
  foundation,
  newChapter,
  buildingOnExperience as boe,
  whatWeBuild,
  markets,
  capabilities,
  whereWeBuild,
  projectsCopy,
  safety,
  safetyTopics,
  newsCopy,
  newsCategories,
  contactCopy,
} from '@/data/services';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured).slice(0, 3);
const news = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const safetyList = Object.values(safetyTopics);
---

<Base intro heroLogo>
  <Hero />

  <!--
    Distribución editorial: los titulares alternan alineación (centro · izquierda · derecha) y escala
    (title · display · mega) para dar ritmo; textos largos en columnas desplazadas.
  -->

  <!-- Texto del hero (documento) + statement bajo el hero: centrado -->
  <section id="intro-statement" class="scroll-mt-(--header-h) bg-bone">
    <div class="container-x py-24 md:py-36">
      <p class="mx-auto max-w-5xl text-center font-editorial text-[clamp(1.7rem,3.7vw,3.5rem)] leading-[1.1] text-ink" data-reveal>{heroCopy.lead}</p>
      <div class="mx-auto mt-14 grid max-w-5xl gap-8 leading-relaxed text-ink/70 md:mt-20 md:grid-cols-2 md:gap-x-14 md:text-lg [&_strong]:font-semibold [&_strong]:text-ink" data-reveal style="--d:2">
        {heroCopy.paragraphs.map((p, i) => <p class:list={[i === 0 && 'text-lead text-ink/85 md:col-span-2 md:mx-auto md:max-w-3xl md:text-center']} set:html={p} />)}
      </div>
      <div class="mt-12 flex flex-wrap justify-center gap-3" data-reveal style="--d:3">
        <Button href={u('/contact?topic=project#form')}>Start a project</Button>
        <Button href={u('/services')} variant="ghost">Our services</Button>
      </div>
    </div>
    <dl class="container-x grid grid-cols-2 border-t border-ink/10 lg:grid-cols-4">
      {
        highlights.map((h, i) => (
          <div class:list={['py-7 pr-4 md:py-9', i % 2 === 1 && 'border-l border-ink/10 pl-5', i >= 2 && 'border-t border-ink/10 lg:border-t-0', 'lg:border-l lg:border-ink/10 lg:px-7 lg:first:border-l-0 lg:first:pl-0']} data-reveal style={`--d:${i}`}>
            <dt class="font-wide text-[clamp(0.85rem,1.4vw,1.1rem)] uppercase leading-tight text-signal">{h.label}</dt>
            <dd class="eyebrow mt-2 text-mute">{h.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- BUILT ON EXPERIENCE (claro): titular grande a la izquierda, texto desplazado a la derecha -->
  <section id="experience" class="scroll-mt-(--header-h) bg-concrete py-24 md:py-40">
    <div class="container-x">
      <SplitText text="Built on experience.|Focused on what|comes next." accent={['next.']} class="max-w-6xl font-editorial text-display" />
      <div class="mt-14 grid gap-10 md:mt-20 lg:grid-cols-12">
        <div class="space-y-6 text-lg leading-relaxed text-ink/75 lg:col-span-6 lg:col-start-7" data-reveal>
          {story.paragraphs.map((p) => <p>{p}</p>)}
          <p class="border-t border-ink/15 pt-6 font-semiwide text-xl font-bold text-ink">{story.proposition}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- OUR FOUNDATION (oscuro): centrado, cuatro columnas con número grande -->
  <section id="foundation" class="on-dark bg-ink py-24 text-bone md:py-36">
    <div class="container-x">
      <p class="eyebrow text-center text-bone/50" data-reveal>Our Foundation</p>
      <SplitText text={foundation.map((f, i) => `${f.title}.${i === 1 ? '|' : ''}`).join(' ')} accent={[`${foundation.at(-1)!.title}.`]} class="mt-6 text-center font-editorial text-display" />
      <ol class="mt-16 grid gap-x-10 gap-y-12 sm:grid-cols-2 md:mt-24 lg:grid-cols-4">
        {
          foundation.map((f, i) => (
            <li class="border-t border-bone/15 pt-7" data-reveal style={`--d:${i}`}>
              <p class="font-editorial text-6xl text-signal md:text-7xl">{f.n}</p>
              <h3 class="mt-6 font-semiwide text-xl font-bold uppercase tracking-wide">{f.title}</h3>
              <p class="mt-3 text-bone/85">{f.lead}</p>
              {f.detail && <p class="mt-2 text-sm text-bone/55">{f.detail}</p>}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- A NEW CHAPTER (claro): titular a la derecha, foto panorámica, texto en dos columnas -->
  <section class="py-24 md:py-36">
    <div class="container-x">
      <SplitText text="A new chapter|in the Grascan story" accent={['story']} class="font-editorial text-display lg:text-right" />
      <div class="mt-12 md:mt-16" data-reveal="mask">
        <Media src={photos.torontoNight} alt="Grascan night works along the Toronto waterfront" class="aspect-[4/3] md:aspect-[21/9]" imgClass="object-[50%_40%]" sizes="100vw" />
      </div>
      <div class="mt-12 grid gap-8 text-ink/75 md:grid-cols-2 md:gap-14 md:text-lg [&_strong]:font-semibold [&_strong]:text-ink" data-reveal>
        {newChapter.paragraphs.map((p, i) => <p class:list={[i === 0 && 'font-editorial text-[clamp(1.4rem,2.4vw,2.1rem)] leading-snug text-ink']} set:html={p} />)}
      </div>
    </div>
  </section>

  <!-- BUILDING ON EXPERIENCE: banner con foto (oscuro), centrado -->
  <section class="on-dark relative overflow-hidden bg-ink py-32 text-bone md:py-48">
    <Media src={photos.curvedTower} alt="" class="absolute inset-0" imgClass="parallax" sizes="100vw" />
    <div class="absolute inset-0 bg-ink/75"></div>
    <div class="container-x relative text-center">
      <SplitText text="Building on|experience." accent={['experience.']} class="font-editorial text-mega" />
      <p class="mx-auto mt-10 max-w-3xl text-lead text-bone/85" data-reveal style="--d:2">{boe.text}</p>
    </div>
  </section>

  <!-- WHAT WE BUILD (claro, tarjetas con foto): titular a la izquierda, texto a la derecha -->
  <section id="what-we-build" class="scroll-mt-(--header-h) py-24 md:py-36">
    <div class="container-x">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <Eyebrow class="mb-6 text-mute">What We Build</Eyebrow>
          <SplitText text="Building for the|demands of today.|Preparing for|what comes next." accent={['next.']} class="font-editorial text-title" />
        </div>
        <div class="space-y-5 leading-relaxed text-ink/70 md:text-lg lg:col-span-4 lg:col-start-9" data-reveal>
          {whatWeBuild.intro.map((p, i) => <p class:list={[i === 0 && 'font-semibold text-ink']}>{p}</p>)}
        </div>
      </div>

      <ul class="mt-16 grid gap-x-5 gap-y-10 sm:grid-cols-2 md:mt-20 lg:grid-cols-5">
        {
          markets.map((m, i) => (
            <li data-reveal style={`--d:${i}`} class:list={[i % 2 === 1 && 'lg:mt-16']}>
              <a href={u(`/markets#${m.slug}`)} class="group block">
                <Media src={marketPhotos[m.slug]} alt={m.title} class="aspect-[4/3] lg:aspect-[3/4]" imgClass="transition-transform duration-[1.4s] ease-(--ease-expo) group-hover:scale-[1.04]" sizes="(min-width: 1024px) 20vw, (min-width: 640px) 50vw, 100vw" />
                <div class="flex items-center justify-between gap-3 border-b border-ink/10 py-5">
                  <h3 class="font-semiwide text-xl font-bold text-ink">{m.title}</h3>
                  <Icon name="arrow" class="size-4 shrink-0 text-signal transition-transform group-hover:translate-x-1" />
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- WHAT WE DO: Our Capabilities (oscuro): titular gigante centrado -->
  <section id="what-we-do" class="on-dark scroll-mt-(--header-h) bg-ink py-24 text-bone md:py-36">
    <div class="container-x">
      <p class="eyebrow text-center text-bone/50" data-reveal>What We Do</p>
      <SplitText text="Our Capabilities" accent={['Capabilities']} class="mt-6 text-center font-editorial text-mega" />

      <ul class="mt-16 border-t border-bone/12 md:mt-24">
        {
          capabilities.map((s, i) => (
            <li data-reveal style={`--d:${i % 3}`}>
              <a href={u(`/services#${s.slug}`)} class="group grid grid-cols-[auto_1fr] gap-5 border-b border-bone/12 py-7 transition-colors hover:bg-ink-2 md:grid-cols-[auto_minmax(0,5fr)_minmax(0,6fr)] md:gap-10 md:px-4 md:py-9">
                <ServiceIcon name={s.icon} class="size-11 text-signal md:size-12" />
                <span class="block self-center font-editorial text-[clamp(1.4rem,2.6vw,2.2rem)] leading-tight transition-transform duration-500 ease-(--ease-expo) group-hover:translate-x-2">{s.title}</span>
                <span class="col-span-2 self-center text-bone/70 md:col-span-1 md:text-lg">{s.text}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-12 text-center" data-reveal><Button href={u('/services')}>All services</Button></div>
    </div>
  </section>

  <!-- WHERE WE BUILD (claro con foto): foto a la izquierda, titular y texto a la derecha -->
  <section id="where-we-build" class="py-24 md:py-36">
    <div class="container-x grid gap-10 md:gap-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5 lg:col-start-8 lg:row-start-1">
        <SplitText text="Where|We Build" accent={['Build']} class="font-editorial text-display" />
        <div class="mt-8 space-y-5 leading-relaxed text-ink/75 md:text-lg" data-reveal style="--d:2">
          {whereWeBuild.paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <p class="mt-8 border-l-2 border-signal pl-6 font-semiwide text-xl font-bold text-ink" data-reveal style="--d:3">{whereWeBuild.closing}</p>
      </div>
      <div class="lg:col-span-6 lg:col-start-1 lg:row-start-1" data-reveal="mask">
        <Media src={photos.gardinerSite} alt="Construction site with the Toronto skyline and CN Tower" class="aspect-[16/10] md:aspect-[16/9] lg:aspect-[4/5]" imgClass="object-[50%_30%]" />
      </div>
    </div>
  </section>

  <!-- FEATURED PROJECTS (claro): titular gigante a la izquierda. Sin proyectos: collage de altura fija en escritorio para que quepa en pantalla -->
  <section id="projects" class="scroll-mt-(--header-h) bg-concrete py-24 md:py-36">
    <div class="container-x">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <SplitText text="Featured|Projects" accent={['Projects']} class="font-editorial text-mega" />
        </div>
        <div class="text-ink/70 md:text-lg lg:col-span-4 [&_strong]:text-ink" data-reveal>
          <p set:html={projectsCopy.intro} />
        </div>
      </div>

      {
        featured.length > 0 ? (
          <div class="mt-16 grid gap-x-8 gap-y-16 md:mt-20 md:grid-cols-3">
            {featured.map((p, i) => <ProjectCard project={p} index={i} />)}
          </div>
        ) : (
          <div class="mt-16 grid gap-4 md:mt-20 md:h-[min(60vh,32rem)] md:grid-cols-12 md:grid-rows-2" data-reveal="mask">
            <Media src={photos.residentialHighrise} alt="Multi-unit residential tower" class="aspect-[16/10] md:col-span-7 md:row-span-2 md:aspect-auto md:h-full" imgClass="object-[50%_35%]" sizes="(min-width: 768px) 58vw, 100vw" />
            <Media src={photos.industrialFacility} alt="Industrial facility" class="aspect-[16/10] md:col-span-5 md:aspect-auto md:h-full" sizes="(min-width: 768px) 42vw, 100vw" />
            <Media src={photos.institutionalCampus} alt="Institutional building" class="aspect-[16/10] md:col-span-5 md:aspect-auto md:h-full" sizes="(min-width: 768px) 42vw, 100vw" />
          </div>
        )
      }

      <div class="mt-12 grid gap-8 md:grid-cols-12 md:items-end" data-reveal>
        <div class="md:col-span-7">
          <h3 class="font-semiwide text-2xl font-bold">{projectsCopy.ourProjects.title}</h3>
          <p class="mt-4 max-w-2xl text-ink/70">{projectsCopy.ourProjects.text}</p>
        </div>
        <div class="md:col-span-5 md:text-right">
          <a href={u('/projects')} class="inline-flex items-center gap-2 font-semibold uppercase tracking-wide text-signal"><span class="link-u">Explore All Projects</span><Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- SAFETY & QUALITY (oscuro): centrado, foto panorámica, temas en rejilla -->
  <section id="safety" class="on-dark relative bg-ink py-24 text-bone md:py-36">
    <div class="container-x relative">
      <p class="eyebrow text-center text-bone/50" data-reveal>Safety & quality</p>
      <SplitText text="Safety is|how we build." accent={['build.']} class="mt-6 text-center font-editorial text-display" />
      <div class="mx-auto mt-10 max-w-3xl space-y-4 text-center text-bone/75 md:text-lg" data-reveal>
        {safety.intro.map((p) => <p>{p}</p>)}
      </div>
      <div class="mt-14 md:mt-20" data-reveal="mask">
        <Media src={photos.interiorFitout} alt="Site team in safety equipment inside a building under construction" class="aspect-[4/3] md:aspect-[21/9]" sizes="100vw" />
      </div>

      <ul class="mt-4 grid gap-px overflow-hidden bg-bone/12 md:grid-cols-2 lg:grid-cols-4">
        {
          safetyList.map((t, i) => (
            <li class="bg-ink p-8" data-reveal style={`--d:${i % 4}`}>
              <h3 class="font-semiwide text-lg font-bold">{t.title}</h3>
              {'lead' in t && <p class="mt-4 font-semibold text-bone">{t.lead}</p>}
              <p class="mt-3 text-sm text-bone/65">{t.text}</p>
            </li>
          ))
        }
        <li class="flex flex-col justify-between gap-8 bg-steel p-8">
          <p class="font-editorial text-3xl text-bone">{safety.closing}</p>
          <a href={u('/health-safety')} class="inline-flex items-center gap-2 font-semibold uppercase tracking-wide text-bone"><span class="link-u">Health & Safety</span><Icon name="arrow" /></a>
        </li>
      </ul>
    </div>
  </section>

  <!-- NEWS & INSIGHTS (claro): titular a la derecha, texto a la izquierda -->
  <section id="news" class="py-24 md:py-36">
    <div class="container-x">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7 lg:col-start-6 lg:row-start-1 lg:text-right">
          <Eyebrow class="mb-6 text-mute">News & insights</Eyebrow>
          <SplitText text="Perspectives from|the people building|what's next." accent={["next."]} class="font-editorial text-title" />
        </div>
        <div class="space-y-4 text-ink/70 lg:col-span-4 lg:col-start-1 lg:row-start-1" data-reveal>
          {newsCopy.intro.map((p) => <p>{p}</p>)}
        </div>
      </div>

      <ul class="mt-16 grid border-t border-ink/10 sm:grid-cols-2 lg:grid-cols-5 md:mt-20">
        {
          newsCategories.map((c, i) => (
            <li class="border-b border-ink/10 py-7 sm:pr-6 lg:border-l lg:px-6 lg:first:border-l-0 lg:first:pl-0" data-reveal style={`--d:${i}`}>
              <h3 class="font-semiwide text-lg font-bold text-signal">{c.title}</h3>
              <p class="mt-2 text-sm text-ink/65">{c.text}</p>
            </li>
          ))
        }
      </ul>

      {
        news.length === 1 ? (
          <div class="mt-16"><NewsCard post={news[0]} feature /></div>
        ) : news.length > 1 && (
          <div class="mt-16 grid gap-12 sm:grid-cols-2 sm:gap-x-6 lg:grid-cols-3 lg:gap-8">
            {news.map((post, i) => <NewsCard post={post} index={i} />)}
          </div>
        )
      }
      <div class="mt-12" data-reveal>
        <a href={u('/news')} class="inline-flex items-center gap-2 font-semibold uppercase tracking-wide text-signal"><span class="link-u">Explore News & Insights</span><Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- CONTACT / OFFICES (gris claro): titular gigante centrado -->
  <section id="contact" class="bg-concrete py-24 md:py-36">
    <div class="container-x">
      <p class="eyebrow text-center text-mute" data-reveal>Contact</p>
      <SplitText text="Let's build|what's next." accent={["next."]} class="mt-6 text-center font-editorial text-mega" />
      <div class="mx-auto mt-10 max-w-2xl space-y-4 text-center text-ink/70 md:text-lg [&_strong]:text-ink" data-reveal>
        {contactCopy.intro.map((p) => <p set:html={p} />)}
      </div>
      <div class="mt-16 md:mt-24"><ContactBlock /></div>
    </div>
  </section>
</Base>
