---
/**
 * HOME — secciones en el orden del documento:
 * Hero · Building on Experience · What We Build · What We Do · Featured Projects ·
 * Our Approach · Safety & Quality · News & Insights · Contact / Offices
 */
import { u } from '@/lib/url';
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import SplitText from '@/components/SplitText.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Button from '@/components/Button.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import NewsCard from '@/components/NewsCard.astro';
import ServiceIcon from '@/components/ServiceIcon.astro';
import ContactBlock from '@/components/ContactBlock.astro';
import Media from '@/components/Media.astro';
import Icon from '@/components/Icon.astro';
import { highlights } from '@/site.config';
import {
  story,
  foundation,
  newChapter,
  buildingOnExperience as boe,
  whatWeBuild,
  sectors,
  whatWeDo,
  capabilities,
  projectsCopy,
  approach,
  commitment,
  safety,
  safetyTopics,
  newsCopy,
  newsCategories,
  contactCopy,
} from '@/data/services';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured).slice(0, 3);
const news = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const safetyList = Object.values(safetyTopics);
---

<Base intro>
  <Hero />

  <!-- Statement bajo el hero -->
  <section aria-label="At a glance" class="on-dark bg-ink text-bone">
    <dl class="container-x grid grid-cols-2 lg:grid-cols-4">
      {
        highlights.map((h, i) => (
          <div class="border-bone/12 py-7 pr-4 even:border-l even:pl-5 [&:nth-child(n+3)]:border-t md:py-9 lg:border-l lg:px-7 lg:first:border-l-0 lg:first:pl-0 lg:[&:nth-child(n+3)]:border-t-0" data-reveal style={`--d:${i}`}>
            <dt class="font-wide text-[clamp(0.85rem,1.5vw,1.15rem)] uppercase leading-tight text-signal">{h.label}</dt>
            <dd class="eyebrow mt-2 text-bone/70">{h.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- BUILDING ON EXPERIENCE -->
  <section id="experience" class="py-24 md:py-36">
    <div class="container-x grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <Eyebrow class="mb-8 text-mute">Building on experience</Eyebrow>
        <SplitText text="Built on experience.|Focused on|what comes next." accent={['next.']} class="font-wide text-title" />
      </div>
      <div class="space-y-6 text-lg leading-relaxed text-ink/75 lg:col-span-5 lg:col-start-8" data-reveal>
        {story.paragraphs.map((p) => <p>{p}</p>)}
        <p class="border-l-4 border-signal pl-5 font-semibold text-ink">{story.proposition}</p>
      </div>
    </div>

    <!-- OUR FOUNDATION -->
    <div class="container-x mt-20 md:mt-28">
      <Eyebrow class="mb-8 text-mute">Our foundation</Eyebrow>
      <ol class="grid border-t border-ink/10 sm:grid-cols-2 lg:grid-cols-4">
        {
          foundation.map((f, i) => (
            <li class="border-b border-ink/10 py-8 sm:pr-8 sm:[&:nth-child(even)]:border-l sm:[&:nth-child(even)]:pl-8 lg:border-l lg:px-8 lg:first:border-l-0 lg:first:pl-0" data-reveal style={`--d:${i}`}>
              <p class="font-wide text-3xl text-gray">{f.n}</p>
              <h3 class="mt-6 font-wide text-xl uppercase text-signal">{f.title}</h3>
              <p class="mt-4 font-semibold text-ink">{f.lead}</p>
              {f.detail && <p class="mt-2 text-ink/65">{f.detail}</p>}
            </li>
          ))
        }
      </ol>
    </div>

    <!-- A new chapter -->
    <div class="container-x mt-20 grid gap-4 md:mt-28 md:grid-cols-12">
      <div class="md:col-span-7" data-reveal="mask"><Media seed="new-chapter" variant="midrise" class="aspect-[16/10] md:aspect-auto md:h-full md:min-h-80" /></div>
      <div class="on-dark flex flex-col justify-between gap-10 bg-ink p-8 md:col-span-5 md:p-12" data-reveal style="--d:2">
        <h3 class="font-wide text-2xl leading-tight md:text-3xl">{newChapter.title}</h3>
        <div class="space-y-4 text-bone/75 [&_strong]:font-semibold [&_strong]:text-bone">
          {newChapter.paragraphs.map((p) => <p set:html={p} />)}
        </div>
      </div>
    </div>
  </section>

  <!-- Banner: BUILDING ON EXPERIENCE (su subtítulo "Building the places that shape Ontario." abre What We Build) -->
  <section class="relative overflow-hidden border-y border-ink/10 bg-concrete py-20 md:py-28">
    <div class="container-x grid gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <SplitText text="Building on|experience." accent={['experience.']} class="font-wide text-display uppercase" />
      </div>
      <p class="text-lead text-ink/75 lg:col-span-5" data-reveal style="--d:2">{boe.text}</p>
    </div>
  </section>

  <!-- WHAT WE BUILD -->
  <section id="what-we-build" class="on-dark relative bg-ink py-24 text-bone md:py-36">
    <div class="bg-grid pointer-events-none absolute inset-0 text-bone/40"></div>
    <div class="container-x relative">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <Eyebrow class="mb-8 text-bone/60">What we build</Eyebrow>
          <SplitText text="Building the places|that shape Ontario." class="font-wide text-title" />
        </div>
        <div class="space-y-4 text-bone/70 lg:col-span-5" data-reveal>
          {whatWeBuild.intro.map((p) => <p>{p}</p>)}
        </div>
      </div>

      <ul class="mt-16 grid gap-px overflow-hidden bg-bone/10 md:mt-20 md:grid-cols-2 lg:grid-cols-3">
        {
          sectors.map((s, i) => {
            const inner = (
              <>
                <ServiceIcon name={s.icon} class="size-12 text-signal" />
                <h3 class="mt-8 font-wide text-xl">{s.title}</h3>
                <p class="mt-4 text-bone/65">{s.text}</p>
              </>
            );
            return (
              <li class="bg-ink" data-reveal style={`--d:${i % 3}`}>
                {s.slug ? (
                  <a href={u(`/services#${s.slug}`)} class="block h-full p-8 transition-colors duration-500 hover:bg-ink-2 md:p-10">{inner}</a>
                ) : (
                  <div class="h-full p-8 md:p-10">{inner}</div>
                )}
              </li>
            );
          })
        }
      </ul>
      <p class="mt-12 font-wide text-lg text-signal md:text-2xl" data-reveal>{whatWeBuild.closing}</p>
    </div>
  </section>

  <!-- WHAT WE DO -->
  <section id="what-we-do" class="py-24 md:py-36">
    <div class="container-x">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <Eyebrow class="mb-8 text-mute">What we do</Eyebrow>
          <SplitText text="From planning|to completion." accent={['completion.']} class="font-wide text-display" />
        </div>
        <div class="space-y-4 text-ink/70 lg:col-span-5" data-reveal>
          {whatWeDo.intro.map((p) => <p>{p}</p>)}
        </div>
      </div>

      <ul class="mt-16 border-t border-ink/10 md:mt-20">
        {
          capabilities.map((s, i) => {
            const Tag = s.slug ? 'a' : 'div';
            return (
              <li data-reveal style={`--d:${i % 3}`}>
                <Tag
                  href={s.slug ? u(`/services#${s.slug}`) : undefined}
                  class:list={['group grid grid-cols-[auto_1fr] gap-5 border-b border-ink/10 py-7 md:grid-cols-[auto_minmax(0,5fr)_minmax(0,6fr)] md:gap-10 md:px-4 md:py-9', s.slug && 'transition-colors hover:bg-concrete']}
                >
                  <ServiceIcon name={s.icon} class="size-11 text-signal md:size-12" />
                  <span>
                    <span class="block font-wide text-[clamp(1.1rem,2vw,1.6rem)] leading-tight">{s.title}</span>
                    <span class="mt-2 block font-semibold text-signal-ink">{s.tagline}</span>
                  </span>
                  <span class="col-span-2 text-ink/70 md:col-span-1">{s.text}</span>
                </Tag>
              </li>
            );
          })
        }
      </ul>
      <div class="mt-12" data-reveal><Button href={u('/services')} variant="dark">All services</Button></div>
    </div>
  </section>

  <!-- FEATURED PROJECTS -->
  <section id="projects" class="border-t border-ink/10 bg-concrete py-24 md:py-36">
    <div class="container-x">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <Eyebrow class="mb-8 text-mute">Featured projects</Eyebrow>
          <SplitText text="Experience|you can see." accent={['see.']} class="font-wide text-display" />
        </div>
        <div class="space-y-4 text-ink/70 lg:col-span-5 [&_strong]:text-ink" data-reveal>
          {projectsCopy.intro.map((p) => <p set:html={p} />)}
        </div>
      </div>

      {
        featured.length > 0 ? (
          <div class="mt-16 grid gap-x-8 gap-y-16 md:mt-20 md:grid-cols-3">
            {featured.map((p, i) => <ProjectCard project={p} index={i} />)}
          </div>
        ) : (
          <div class="mt-16 grid gap-px overflow-hidden border border-ink/10 bg-ink/10 md:mt-20 md:grid-cols-3" data-reveal>
            {(['tower', 'warehouse', 'campus'] as const).map((v, i) => (
              <Media seed={`portfolio-${v}`} variant={v} class="aspect-[4/3]" label={false} tone={i === 1 ? 'dark' : 'light'} />
            ))}
          </div>
        )
      }

      <div class="mt-12 grid gap-8 md:grid-cols-12 md:items-end" data-reveal>
        <div class="md:col-span-7">
          <h3 class="font-wide text-xl">{projectsCopy.ourProjects.title}</h3>
          <p class="mt-4 max-w-2xl text-ink/70">{projectsCopy.ourProjects.text}</p>
        </div>
        <div class="md:col-span-5 md:text-right">
          <a href={u('/projects')} class="inline-flex items-center gap-2 font-semibold uppercase tracking-wide text-signal"><span class="link-u">Explore all projects</span><Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- OUR APPROACH -->
  <section id="approach" class="py-24 md:py-36">
    <div class="container-x">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <Eyebrow class="mb-8 text-mute">Our approach</Eyebrow>
          <SplitText text="Built on experience.|Driven by execution." accent={['execution.']} class="font-wide text-title" />
        </div>
        <div class="space-y-4 text-ink/70 lg:col-span-5" data-reveal>
          {approach.intro.map((p) => <p>{p}</p>)}
        </div>
      </div>

      <ol class="mt-16 grid gap-px overflow-hidden border border-ink/10 bg-ink/10 md:mt-20 md:grid-cols-2 lg:grid-cols-4">
        {
          approach.steps.map((s, i) => (
            <li class="bg-bone p-8 md:p-10" data-reveal style={`--d:${i}`}>
              <p class="eyebrow text-mute">Step {String(i + 1).padStart(2, '0')}</p>
              <h3 class="mt-6 font-wide text-2xl text-signal">{s.title}</h3>
              <p class="mt-5 font-semibold text-ink">{s.lead}</p>
              <p class="mt-3 text-ink/65">{s.text}</p>
            </li>
          ))
        }
      </ol>

      <div class="mt-20 grid gap-10 md:mt-28 lg:grid-cols-12">
        <h3 class="font-wide text-2xl lg:col-span-4 md:text-3xl" data-reveal>Our Commitment</h3>
        <dl class="grid gap-x-10 border-t border-ink/10 sm:grid-cols-2 lg:col-span-8">
          {
            commitment.map((c, i) => (
              <div class="border-b border-ink/10 py-6" data-reveal style={`--d:${i % 2}`}>
                <dt class="font-semiwide text-lg font-bold text-ink">{c.title}.</dt>
                <dd class="mt-1 text-ink/65">{c.text}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- SAFETY & QUALITY -->
  <section id="safety" class="on-dark relative bg-ink py-24 text-bone md:py-36">
    <div class="bg-grid pointer-events-none absolute inset-0 text-bone/40"></div>
    <div class="container-x relative">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-6">
          <Eyebrow class="mb-8 text-bone/60">Safety & quality</Eyebrow>
          <SplitText text="Safety is|how we build." class="font-wide text-display" />
        </div>
        <div class="space-y-4 text-bone/70 lg:col-span-5 lg:col-start-8" data-reveal>
          {safety.intro.map((p) => <p>{p}</p>)}
        </div>
      </div>

      <ul class="mt-16 grid gap-px overflow-hidden bg-bone/10 md:mt-20 md:grid-cols-2 lg:grid-cols-3">
        {
          safetyList.map((t, i) => (
            <li class:list={['bg-ink p-8 md:p-10', i === safetyList.length - 1 && 'lg:col-span-1 md:col-span-2']} data-reveal style={`--d:${i % 3}`}>
              <span class="block h-1 w-10 bg-signal" aria-hidden="true"></span>
              <h3 class="mt-6 font-wide text-lg">{t.title}</h3>
              {'lead' in t && <p class="mt-4 font-semibold text-bone">{t.lead}</p>}
              <p class="mt-3 text-bone/65">{t.text}</p>
            </li>
          ))
        }
        <li class="hidden bg-steel p-8 md:p-10 lg:flex lg:flex-col lg:justify-between lg:col-span-2">
          <p class="font-wide text-2xl text-bone xl:text-3xl">{safety.closing}</p>
          <a href={u('/health-safety')} class="mt-8 inline-flex items-center gap-2 font-semibold uppercase tracking-wide text-bone"><span class="link-u">Health & Safety</span><Icon name="arrow" /></a>
        </li>
      </ul>
      <div class="mt-10 flex flex-wrap items-center justify-between gap-6 lg:hidden" data-reveal>
        <p class="font-wide text-xl text-signal">{safety.closing}</p>
        <Button href={u('/health-safety')}>Health & Safety</Button>
      </div>
    </div>
  </section>

  <!-- NEWS & INSIGHTS -->
  <section id="news" class="py-24 md:py-36">
    <div class="container-x">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <Eyebrow class="mb-8 text-mute">News & insights</Eyebrow>
          <SplitText text="Perspectives from|the people building|what's next." accent={["next."]} class="font-wide text-title" />
        </div>
        <div class="space-y-4 text-ink/70 lg:col-span-5" data-reveal>
          {newsCopy.intro.map((p) => <p>{p}</p>)}
        </div>
      </div>

      <ul class="mt-16 grid border-t border-ink/10 sm:grid-cols-2 lg:grid-cols-5 md:mt-20">
        {
          newsCategories.map((c, i) => (
            <li class="border-b border-ink/10 py-7 sm:pr-6 lg:border-l lg:px-6 lg:first:border-l-0 lg:first:pl-0" data-reveal style={`--d:${i}`}>
              <h3 class="font-semiwide text-lg font-bold text-signal">{c.title}</h3>
              <p class="mt-2 text-sm text-ink/65">{c.text}</p>
            </li>
          ))
        }
      </ul>

      {
        news.length > 0 && (
          <div class="mt-16 grid gap-12 sm:grid-cols-2 sm:gap-x-6 lg:grid-cols-3 lg:gap-8">
            {news.map((post, i) => <NewsCard post={post} index={i} />)}
          </div>
        )
      }
      <div class="mt-12" data-reveal>
        <a href={u('/news')} class="inline-flex items-center gap-2 font-semibold uppercase tracking-wide text-signal"><span class="link-u">Explore News & Insights</span><Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- CONTACT / OFFICES -->
  <section id="contact" class="border-t border-ink/10 bg-concrete py-24 md:py-36">
    <div class="container-x">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-6">
          <Eyebrow class="mb-8 text-mute">Contact</Eyebrow>
          <SplitText text="Let's build|what's next." accent={["next."]} class="font-wide text-display" />
        </div>
        <div class="space-y-4 text-ink/70 lg:col-span-5 lg:col-start-8 [&_strong]:text-ink" data-reveal>
          {contactCopy.intro.map((p) => <p set:html={p} />)}
        </div>
      </div>
      <div class="mt-16 md:mt-20"><ContactBlock /></div>
    </div>
  </section>
</Base>
