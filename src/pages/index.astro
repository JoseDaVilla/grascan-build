---
/**
 * HOME — secciones en el orden del documento, alternando fondos claros y oscuros:
 * Hero · Building on Experience · Our Foundation · A new chapter · What We Build · What We Do ·
 * Featured Projects · Our Approach · Safety & Quality · News & Insights · Contact / Offices
 */
import { u } from '@/lib/url';
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import SplitText from '@/components/SplitText.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import Button from '@/components/Button.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import NewsCard from '@/components/NewsCard.astro';
import ServiceIcon from '@/components/ServiceIcon.astro';
import ContactBlock from '@/components/ContactBlock.astro';
import Media from '@/components/Media.astro';
import Icon from '@/components/Icon.astro';
import { photos, servicePhotos } from '@/data/photos';
import { site, highlights } from '@/site.config';
import {
  story,
  foundation,
  newChapter,
  buildingOnExperience as boe,
  whatWeBuild,
  sectors,
  whatWeDo,
  capabilities,
  projectsCopy,
  approach,
  commitment,
  safety,
  safetyTopics,
  newsCopy,
  newsCategories,
  contactCopy,
} from '@/data/services';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured).slice(0, 3);
const news = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const safetyList = Object.values(safetyTopics);
---

<Base intro darkHero heroLogo>
  <Hero />

  <!-- Texto del hero (documento) + statement bajo el hero -->
  <section id="intro-statement" class="scroll-mt-(--header-h) border-b border-ink/10 bg-bone">
    <div class="container-x grid gap-12 py-20 md:py-28 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="font-wide text-[clamp(1.35rem,2.6vw,2.3rem)] leading-[1.2] text-ink" data-reveal>A new generation of building construction, backed by decades of experience delivering complex projects across Ontario.</p>
      </div>
      <div class="lg:col-span-4 lg:col-start-9" data-reveal style="--d:2">
        <p class="text-ink/70">{site.description}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={u('/contact?topic=project#form')}>Start a project</Button>
          <Button href={u('/services')} variant="ghost">Our services</Button>
        </div>
      </div>
    </div>
    <dl class="container-x grid grid-cols-2 border-t border-ink/10 lg:grid-cols-4">
      {
        highlights.map((h, i) => (
          <div class:list={['py-7 pr-4 md:py-9', i % 2 === 1 && 'border-l border-ink/10 pl-5', i >= 2 && 'border-t border-ink/10 lg:border-t-0', 'lg:border-l lg:border-ink/10 lg:px-7 lg:first:border-l-0 lg:first:pl-0']} data-reveal style={`--d:${i}`}>
            <dt class="font-wide text-[clamp(0.85rem,1.4vw,1.1rem)] uppercase leading-tight text-signal">{h.label}</dt>
            <dd class="eyebrow mt-2 text-mute">{h.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- BUILDING ON EXPERIENCE (claro) -->
  <section id="experience" class="bg-concrete py-24 md:py-36">
    <div class="container-x grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <Eyebrow class="mb-8 text-mute">Building on experience</Eyebrow>
        <SplitText text="Built on experience.|Focused on|what comes next." accent={['next.']} class="font-wide text-title" />
      </div>
      <div class="space-y-6 text-lg leading-relaxed text-ink/75 lg:col-span-5 lg:col-start-8" data-reveal>
        {story.paragraphs.map((p) => <p>{p}</p>)}
        <p class="border-t border-ink/15 pt-6 font-semibold text-ink">{story.proposition}</p>
      </div>
    </div>
  </section>

  <!-- OUR FOUNDATION (oscuro) -->
  <section id="foundation" class="on-dark bg-ink py-24 text-bone md:py-32">
    <div class="container-x">
      <SplitText text="Our Foundation" class="font-wide text-title" />
      <ol class="mt-14 grid gap-px overflow-hidden bg-bone/12 sm:grid-cols-2 lg:grid-cols-4 md:mt-20">
        {
          foundation.map((f, i) => (
            <li class="bg-ink p-8 md:p-10" data-reveal style={`--d:${i}`}>
              <p class="font-wide text-4xl text-signal">{f.n}</p>
              <h3 class="mt-8 font-wide text-xl uppercase">{f.title}</h3>
              <p class="mt-4 font-semibold text-bone">{f.lead}</p>
              {f.detail && <p class="mt-2 text-bone/65">{f.detail}</p>}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- A NEW CHAPTER (claro) -->
  <section class="py-24 md:py-36">
    <div class="container-x grid gap-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-6" data-reveal="mask">
        <Media src={photos.toronto} alt="Toronto skyline with the CN Tower" class="aspect-[4/5] md:aspect-[4/3] lg:aspect-[5/6]" />
      </div>
      <div class="lg:col-span-5 lg:col-start-8">
        <SplitText text="A new chapter|in the Grascan story" accent={['story']} class="font-wide text-title" />
        <div class="mt-8 space-y-5 text-lg text-ink/75 [&_strong]:font-semibold [&_strong]:text-ink" data-reveal style="--d:2">
          {newChapter.paragraphs.map((p) => <p set:html={p} />)}
        </div>
      </div>
    </div>
  </section>

  <!-- BUILDING ON EXPERIENCE: banner con foto (oscuro) -->
  <section class="on-dark relative overflow-hidden bg-ink py-28 text-bone md:py-40">
    <Media src={photos.cranes} alt="" class="absolute inset-0" imgClass="parallax" sizes="100vw" />
    <div class="absolute inset-0 bg-ink/80"></div>
    <div class="container-x relative grid gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <SplitText text="Building on|experience." accent={['experience.']} class="font-wide text-display uppercase" />
      </div>
      <p class="text-lead text-bone/85 lg:col-span-5" data-reveal style="--d:2">{boe.text}</p>
    </div>
  </section>

  <!-- WHAT WE BUILD (claro, tarjetas con foto) -->
  <section id="what-we-build" class="py-24 md:py-36">
    <div class="container-x">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <Eyebrow class="mb-8 text-mute">What we build</Eyebrow>
          <SplitText text="Building the places|that shape Ontario." accent={['Ontario.']} class="font-wide text-title" />
        </div>
        <div class="space-y-4 text-ink/70 lg:col-span-5" data-reveal>
          {whatWeBuild.intro.map((p) => <p>{p}</p>)}
        </div>
      </div>

      <ul class="mt-16 grid gap-x-6 gap-y-12 md:mt-20 md:grid-cols-2 lg:grid-cols-3">
        {
          sectors.map((s, i) => {
            const img = servicePhotos[s.slug ?? 'healthcare'];
            const inner = (
              <>
                <Media src={img} alt={s.title} class="aspect-[4/3]" imgClass="transition-transform duration-[1.4s] ease-(--ease-expo) group-hover:scale-[1.04]" sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" />
                <div class="border-b border-ink/10 py-6">
                  <h3 class="font-wide text-xl text-ink">{s.title}</h3>
                  <p class="mt-3 text-ink/70">{s.text}</p>
                </div>
              </>
            );
            return (
              <li data-reveal style={`--d:${i % 3}`}>
                {s.slug ? <a href={u(`/services#${s.slug}`)} class="group block">{inner}</a> : <div>{inner}</div>}
              </li>
            );
          })
        }
      </ul>
      <p class="mt-14 font-wide text-lg text-signal md:text-2xl" data-reveal>{whatWeBuild.closing}</p>
    </div>
  </section>

  <!-- WHAT WE DO (oscuro) -->
  <section id="what-we-do" class="on-dark bg-ink py-24 text-bone md:py-36">
    <div class="container-x">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <Eyebrow class="mb-8 text-bone/60">What we do</Eyebrow>
          <SplitText text="From planning|to completion." accent={['completion.']} class="font-wide text-display" />
        </div>
        <div class="space-y-4 text-bone/70 lg:col-span-5" data-reveal>
          {whatWeDo.intro.map((p) => <p>{p}</p>)}
        </div>
      </div>

      <ul class="mt-16 border-t border-bone/12 md:mt-20">
        {
          capabilities.map((s, i) => {
            const Tag = s.slug ? 'a' : 'div';
            return (
              <li data-reveal style={`--d:${i % 3}`}>
                <Tag
                  href={s.slug ? u(`/services#${s.slug}`) : undefined}
                  class:list={['group grid grid-cols-[auto_1fr] gap-5 border-b border-bone/12 py-7 md:grid-cols-[auto_minmax(0,5fr)_minmax(0,6fr)] md:gap-10 md:px-4 md:py-9', s.slug && 'transition-colors hover:bg-ink-2']}
                >
                  <ServiceIcon name={s.icon} class="size-11 text-signal md:size-12" />
                  <span>
                    <span class="block font-wide text-[clamp(1.1rem,2vw,1.6rem)] leading-tight">{s.title}</span>
                    <span class="mt-2 block font-semibold text-signal">{s.tagline}</span>
                  </span>
                  <span class="col-span-2 text-bone/70 md:col-span-1">{s.text}</span>
                </Tag>
              </li>
            );
          })
        }
      </ul>
      <div class="mt-12" data-reveal><Button href={u('/services')}>All services</Button></div>
    </div>
  </section>

  <!-- FEATURED PROJECTS (claro) -->
  <section id="projects" class="py-24 md:py-36">
    <div class="container-x">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <Eyebrow class="mb-8 text-mute">Featured projects</Eyebrow>
          <SplitText text="Experience|you can see." accent={['see.']} class="font-wide text-display" />
        </div>
        <div class="space-y-4 text-ink/70 lg:col-span-5 [&_strong]:text-ink" data-reveal>
          {projectsCopy.intro.map((p) => <p set:html={p} />)}
        </div>
      </div>

      {
        featured.length > 0 ? (
          <div class="mt-16 grid gap-x-8 gap-y-16 md:mt-20 md:grid-cols-3">
            {featured.map((p, i) => <ProjectCard project={p} index={i} />)}
          </div>
        ) : (
          <div class="mt-16 grid gap-4 md:mt-20 md:grid-cols-12" data-reveal="mask">
            <Media src={photos.officeTowers} alt="Commercial buildings" class="aspect-[4/3] md:col-span-7 md:aspect-auto md:h-full" sizes="(min-width: 768px) 58vw, 100vw" />
            <div class="grid gap-4 md:col-span-5">
              <Media src={photos.industrial} alt="Industrial facility" class="aspect-[16/10]" sizes="(min-width: 768px) 42vw, 100vw" />
              <Media src={photos.institutional} alt="Institutional building" class="aspect-[16/10]" sizes="(min-width: 768px) 42vw, 100vw" />
            </div>
          </div>
        )
      }

      <div class="mt-12 grid gap-8 md:grid-cols-12 md:items-end" data-reveal>
        <div class="md:col-span-7">
          <h3 class="font-wide text-xl">{projectsCopy.ourProjects.title}</h3>
          <p class="mt-4 max-w-2xl text-ink/70">{projectsCopy.ourProjects.text}</p>
        </div>
        <div class="md:col-span-5 md:text-right">
          <a href={u('/projects')} class="inline-flex items-center gap-2 font-semibold uppercase tracking-wide text-signal"><span class="link-u">Explore all projects</span><Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- OUR APPROACH (gris claro) -->
  <section id="approach" class="bg-concrete py-24 md:py-36">
    <div class="container-x">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <Eyebrow class="mb-8 text-mute">Our approach</Eyebrow>
          <SplitText text="Built on experience.|Driven by execution." accent={['execution.']} class="font-wide text-title" />
        </div>
        <div class="space-y-4 text-ink/70 lg:col-span-5" data-reveal>
          {approach.intro.map((p) => <p>{p}</p>)}
        </div>
      </div>

      <ol class="mt-16 grid gap-px overflow-hidden border border-ink/10 bg-ink/10 md:mt-20 md:grid-cols-2 lg:grid-cols-4">
        {
          approach.steps.map((s, i) => (
            <li class="bg-bone p-8 md:p-10" data-reveal style={`--d:${i}`}>
              <p class="font-wide text-3xl text-gray">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="mt-6 font-wide text-2xl text-signal">{s.title}</h3>
              <p class="mt-5 font-semibold text-ink">{s.lead}</p>
              <p class="mt-3 text-ink/65">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- OUR COMMITMENT (claro) -->
  <section class="py-24 md:py-32">
    <div class="container-x grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <SplitText text="Our|Commitment" class="font-wide text-title" />
      </div>
      <dl class="grid gap-x-10 border-t border-ink/10 sm:grid-cols-2 lg:col-span-8">
        {
          commitment.map((c, i) => (
            <div class="border-b border-ink/10 py-6" data-reveal style={`--d:${i % 2}`}>
              <dt class="font-wide text-lg text-ink">{c.title}.</dt>
              <dd class="mt-2 text-ink/65">{c.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- SAFETY & QUALITY (oscuro con foto) -->
  <section id="safety" class="on-dark relative bg-ink py-24 text-bone md:py-36">
    <div class="container-x relative">
      <div class="grid gap-12 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-6">
          <Eyebrow class="mb-8 text-bone/60">Safety & quality</Eyebrow>
          <SplitText text="Safety is|how we build." class="font-wide text-display" />
          <div class="mt-8 space-y-4 text-bone/75" data-reveal>
            {safety.intro.map((p) => <p>{p}</p>)}
          </div>
        </div>
        <div class="lg:col-span-5 lg:col-start-8" data-reveal="mask">
          <Media src={photos.siteSafety} alt="Construction crew wearing safety equipment on site" class="aspect-[4/3]" />
        </div>
      </div>

      <ul class="mt-16 grid gap-px overflow-hidden bg-bone/12 md:mt-20 md:grid-cols-2 lg:grid-cols-4">
        {
          safetyList.map((t, i) => (
            <li class="bg-ink p-8" data-reveal style={`--d:${i % 4}`}>
              <h3 class="font-wide text-base">{t.title}</h3>
              {'lead' in t && <p class="mt-4 font-semibold text-bone">{t.lead}</p>}
              <p class="mt-3 text-sm text-bone/65">{t.text}</p>
            </li>
          ))
        }
        <li class="flex flex-col justify-between gap-8 bg-steel p-8">
          <p class="font-wide text-xl text-bone">{safety.closing}</p>
          <a href={u('/health-safety')} class="inline-flex items-center gap-2 font-semibold uppercase tracking-wide text-bone"><span class="link-u">Health & Safety</span><Icon name="arrow" /></a>
        </li>
      </ul>
    </div>
  </section>

  <!-- NEWS & INSIGHTS (claro) -->
  <section id="news" class="py-24 md:py-36">
    <div class="container-x">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <Eyebrow class="mb-8 text-mute">News & insights</Eyebrow>
          <SplitText text="Perspectives from|the people building|what's next." accent={["next."]} class="font-wide text-title" />
        </div>
        <div class="space-y-4 text-ink/70 lg:col-span-5" data-reveal>
          {newsCopy.intro.map((p) => <p>{p}</p>)}
        </div>
      </div>

      <ul class="mt-16 grid border-t border-ink/10 sm:grid-cols-2 lg:grid-cols-5 md:mt-20">
        {
          newsCategories.map((c, i) => (
            <li class="border-b border-ink/10 py-7 sm:pr-6 lg:border-l lg:px-6 lg:first:border-l-0 lg:first:pl-0" data-reveal style={`--d:${i}`}>
              <h3 class="font-semiwide text-lg font-bold text-signal">{c.title}</h3>
              <p class="mt-2 text-sm text-ink/65">{c.text}</p>
            </li>
          ))
        }
      </ul>

      {
        news.length === 1 ? (
          <div class="mt-16"><NewsCard post={news[0]} feature /></div>
        ) : news.length > 1 && (
          <div class="mt-16 grid gap-12 sm:grid-cols-2 sm:gap-x-6 lg:grid-cols-3 lg:gap-8">
            {news.map((post, i) => <NewsCard post={post} index={i} />)}
          </div>
        )
      }
      <div class="mt-12" data-reveal>
        <a href={u('/news')} class="inline-flex items-center gap-2 font-semibold uppercase tracking-wide text-signal"><span class="link-u">Explore News & Insights</span><Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- CONTACT / OFFICES (gris claro) -->
  <section id="contact" class="bg-concrete py-24 md:py-36">
    <div class="container-x">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-6">
          <Eyebrow class="mb-8 text-mute">Contact</Eyebrow>
          <SplitText text="Let's build|what's next." accent={["next."]} class="font-wide text-display" />
        </div>
        <div class="space-y-4 text-ink/70 lg:col-span-5 lg:col-start-8 [&_strong]:text-ink" data-reveal>
          {contactCopy.intro.map((p) => <p set:html={p} />)}
        </div>
      </div>
      <div class="mt-16 md:mt-20"><ContactBlock /></div>
    </div>
  </section>
</Base>
