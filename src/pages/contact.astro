---
/**
 * CONTACT: Contact Us. Textos del documento.
 * TODO (cliente): email, teléfono y dirección de oficina "waiting for info". Se rellenan en src/site.config.ts.
 */
import { u } from '@/lib/url';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import ContactBlock from '@/components/ContactBlock.astro';
import { site } from '@/site.config';
import { contactCopy } from '@/data/services';

const strip = (html: string) => html.replace(/<[^>]+>/g, '');
const topics = [
  { value: 'project', label: 'Start a project' },
  { value: 'general', label: 'General inquiry' },
  { value: 'careers', label: 'Careers' },
  { value: 'safety', label: 'Health & Safety' },
  { value: 'other', label: 'Other' },
];
---

<Base title="Contact" description={strip(contactCopy.intro[0])}>
  <PageHero eyebrow="Contact" title="Let's build|what's next." accent={["next."]}>
    <div class="mt-8 max-w-2xl space-y-4 text-lead text-ink/70 [&_strong]:text-ink" data-reveal style="--d:4">
      {contactCopy.intro.map((p) => <p set:html={p} />)}
    </div>
  </PageHero>

  <section class="py-20 md:py-28">
    <div class="container-x">
      <ContactBlock />
    </div>
  </section>

  <!-- Formulario -->
  <section id="form" class="scroll-mt-24 border-t border-ink/10 bg-concrete py-20 md:py-28">
    <div class="container-x grid gap-16 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <Eyebrow class="mb-8 text-mute">Send a message</Eyebrow>
        <h2 class="font-wide text-title">{contactCopy.start.lead}</h2>
        <p class="mt-6 text-ink/70">{strip(contactCopy.intro[1])}</p>
      </div>
      <form name="contact" method="POST" action={site.formEndpoint || u('/thanks')} data-netlify="true" netlify-honeypot="bot-field" class="lg:col-span-7 lg:col-start-6">
        <input type="hidden" name="form-name" value="contact" />
        <p hidden><label>Don't fill this out: <input name="bot-field" /></label></p>
        <div class="grid gap-8 md:grid-cols-2" data-reveal>
          <div class="field"><label class="field-label" for="c-name">Name *</label><input class="input" id="c-name" name="name" required autocomplete="name" /></div>
          <div class="field"><label class="field-label" for="c-company">Company</label><input class="input" id="c-company" name="company" autocomplete="organization" /></div>
          <div class="field"><label class="field-label" for="c-email">Email *</label><input class="input" id="c-email" name="email" type="email" required autocomplete="email" /></div>
          <div class="field"><label class="field-label" for="c-phone">Phone</label><input class="input" id="c-phone" name="phone" type="tel" autocomplete="tel" /></div>
          <div class="field md:col-span-2">
            <label class="field-label" for="c-topic">Inquiry type</label>
            <select class="input" id="c-topic" name="topic">
              {topics.map((t) => <option value={t.value}>{t.label}</option>)}
            </select>
          </div>
          <div class="field md:col-span-2"><label class="field-label" for="c-message">Project details or message *</label><textarea class="input" id="c-message" name="message" rows="5" required placeholder="Tell us about your project, objectives and timeline."></textarea></div>
        </div>
        <div class="mt-10 flex flex-wrap items-center justify-between gap-6" data-reveal>
          <p class="max-w-sm text-sm text-mute">By submitting you agree to our <a href={u('/privacy')} class="underline underline-offset-4">privacy policy</a>.</p>
          <button type="submit" class="btn btn-primary">Send message</button>
        </div>
      </form>
    </div>
  </section>
</Base>

<script>
  // Preselecciona el tipo de consulta desde ?topic= (CTA "Start a project", "Contact our team"...)
  const topic = new URLSearchParams(location.search).get('topic');
  const select = document.getElementById('c-topic') as HTMLSelectElement | null;
  if (topic && select && [...select.options].some((o) => o.value === topic)) select.value = topic;
</script>
