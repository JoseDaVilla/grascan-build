---
/**
 * Hero de la home (texto del documento "Website GRASCAN BUILD"):
 * GRASCAN BUILD · Buildings & Development · Backed by Grascan Construction since 1987
 * BUILT ON EXPERIENCE. READY FOR WHAT'S NEXT.
 */
import { u } from '@/lib/url';
import { site } from '@/site.config';
import { services } from '@/data/services';
import HeroScene from './HeroScene.astro';
import SplitText from './SplitText.astro';
import Button from './Button.astro';

interface Props {
  /** Vídeo de fondo opcional (mp4/webm en /public). Si no se pasa, se usa la escena SVG. */
  video?: { src: string; poster?: string };
}
const { video } = Astro.props;
---

<section class="hero relative flex min-h-[100svh] flex-col overflow-hidden bg-bone text-ink" style="--intro: var(--intro-delay, 0ms)">
  <div class="bg-grid pointer-events-none absolute inset-0 text-signal/60"></div>

  {
    video ? (
      <video class="absolute inset-0 h-full w-full object-cover opacity-60" autoplay muted loop playsinline preload="metadata" poster={video.poster}>
        <source src={video.src} type="video/mp4" />
      </video>
    ) : (
      <div class="absolute inset-x-0 bottom-0 top-(--header-h) opacity-[0.16] md:left-[40%] md:opacity-40 lg:left-[58%] lg:opacity-100 2xl:left-[60%]">
        <HeroScene />
      </div>
    )
  }

  <div class="container-x relative flex flex-1 flex-col justify-end pt-[calc(var(--header-h)+3.5rem)] pb-10 md:pb-14">
    <div class="hero-fade mb-8 flex flex-wrap items-center gap-x-5 gap-y-3 md:mb-10" style="--k:0">
      <p class="border-l-4 border-signal pl-4">
        <span class="block font-wide text-lg leading-tight text-signal md:text-xl">{site.legalName}</span>
        <span class="eyebrow mt-1 block text-mute">Buildings & Development</span>
      </p>
      <p class="eyebrow border border-ink/15 px-3 py-2 text-ink/70">Backed by Grascan Construction since {site.founded}</p>
    </div>

    <SplitText
      as="h1"
      text="Built on|experience.|Ready for|what's next."
      accent={['experience.']}
      afterIntro
      delay={150}
      class="max-w-[60%] font-wide text-[clamp(2.1rem,4.6vw,4.9rem)] leading-[1.02] uppercase max-lg:max-w-none"
    />

    <div class="mt-10 grid gap-10 md:mt-12 lg:grid-cols-12 lg:items-end">
      <div class="hero-fade lg:col-span-6 xl:col-span-5" style="--k:1">
        <p class="max-w-lg text-lead font-semibold text-ink">A new generation of building construction, backed by decades of experience delivering complex projects across Ontario.</p>
        <p class="mt-4 max-w-lg text-ink/70">{site.description}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={u('/contact?topic=project#form')}>Start a project</Button>
          <Button href={u('/services')} variant="ghost">Our services</Button>
        </div>
      </div>
    </div>
  </div>

  <!-- Barra inferior: servicios en loop -->
  <div class="hero-fade relative border-t border-ink/10 bg-bone/70 backdrop-blur-sm" style="--k:3">
    <div class="container-x flex items-center gap-8 py-4">
      <div class="marquee eyebrow flex-1 text-mute" style="--speed:40s; --gap:2.5rem">
        {[0, 1].map((k) => (
          <ul class="marquee-track" aria-hidden={k === 1 ? 'true' : undefined}>
            {services.map((s) => <li class="flex items-center gap-10 whitespace-nowrap"><span>{s.title}</span><span class="text-gray">/</span></li>)}
          </ul>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .js .hero-fade {
    opacity: 0;
    transform: translateY(24px);
    animation: hero-in 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(var(--intro) + 700ms + var(--k) * 120ms);
  }
  @keyframes hero-in {
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
