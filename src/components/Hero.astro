---
/**
 * Hero de la home, estilo corporativo: logo centrado sobre fotos que pasan por detrás (fundido cada 6 s).
 * Jerarquía: logo GRASCAN BUILD · BUILDINGS & DEVELOPMENT · Backed by Grascan Construction since 1987
 * (mediano) · slogan "Built on experience. Ready for what's next." (menor).
 * El resto del texto del hero del documento va en la franja inmediatamente inferior (index.astro).
 */
import { Image } from 'astro:assets';
import { site } from '@/site.config';
import { heroSlides } from '@/data/photos';
import Logo from './Logo.astro';
---

<section class="hero on-dark relative flex min-h-[100svh] flex-col overflow-hidden bg-ink text-bone" data-slideshow>
  <div class="absolute inset-0" aria-hidden="true">
    {
      heroSlides.map((s, i) => (
        <div class:list={['hero-slide absolute inset-0', i === 0 && 'is-active']} data-slide>
          <Image src={s.src} alt="" widths={[768, 1280, 1920, 2400]} sizes="100vw" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} class="h-full w-full object-cover" />
        </div>
      ))
    }
    <div class="absolute inset-0 bg-ink/75"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_0%,rgb(4_18_38/0.55)_100%)]"></div>
  </div>

  <div class="container-x relative flex flex-1 flex-col items-center justify-center pt-(--header-h) pb-24 text-center">
    <h1 class="hero-fade" style="--k:0">
      <Logo variant="full" class="mx-auto w-[min(62vw,21rem)] !text-bone md:w-[24rem]" />
    </h1>

    <p class="hero-fade mt-10 font-semibold uppercase tracking-[0.32em] text-bone text-[clamp(0.85rem,1.6vw,1.2rem)] md:mt-12" style="--k:1">Buildings & Development</p>

    <span class="hero-fade mt-8 block h-px w-16 bg-bone/50" style="--k:1" aria-hidden="true"></span>

    <p class="hero-fade mt-8 text-[clamp(1rem,1.7vw,1.35rem)] font-medium uppercase tracking-[0.12em] text-bone/90" style="--k:2">Backed by Grascan Construction since {site.founded}</p>

    <p class="hero-fade mt-4 font-wide text-[clamp(0.8rem,1.2vw,1rem)] uppercase tracking-[0.06em] text-bone/60" style="--k:3">Built on experience. Ready for what's next.</p>
  </div>

  <a href="#intro-statement" class="hero-fade absolute bottom-8 left-1/2 -translate-x-1/2 p-2 text-bone/80 transition-colors hover:text-bone" style="--k:4" aria-label="Scroll to content">
    <svg viewBox="0 0 24 24" class="hero-chevron size-7" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M6 6l6 6 6-6M6 12l6 6 6-6" /></svg>
  </a>

  <div class="absolute bottom-9 right-[clamp(1rem,4vw,3.5rem)] z-10 hidden gap-2 md:flex" role="group" aria-label="Slides">
    {heroSlides.map((s, i) => (
      <button type="button" class:list={['hero-dot h-[3px] w-8 bg-bone/30 transition-colors', i === 0 && 'is-active']} data-slide-dot={i} aria-label={`Show slide ${i + 1}: ${s.alt}`}></button>
    ))}
  </div>
</section>

<style>
  .hero-slide {
    opacity: 0;
    transition: opacity 1.6s ease;
  }
  .hero-slide.is-active {
    opacity: 1;
  }
  .hero-slide :global(img) {
    transform: scale(1.06);
    transition: transform 8s linear;
  }
  .hero-slide.is-active :global(img) {
    transform: scale(1);
  }
  .hero-dot.is-active {
    background: var(--color-bone);
  }
  .hero-chevron {
    animation: nudge 2.4s ease-in-out infinite;
  }
  @keyframes nudge {
    50% {
      transform: translateY(5px);
    }
  }
  .js .hero-fade {
    opacity: 0;
    animation: hero-in 1.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(var(--intro-delay, 0ms) + 250ms + var(--k) * 160ms);
  }
  @keyframes hero-in {
    from {
      opacity: 0;
      translate: 0 18px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
</style>
