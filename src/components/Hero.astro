---
/**
 * Hero de la home: sólo el logo Grascan Build con sus colores originales, sobre blanco. El logo nunca
 * cambia de color ni de sitio: la intro ocurre en el propio hero. Tres variantes para presentar al
 * cliente (las elige Base.astro según la URL y queda en html[data-intro]):
 *  - ?intro1 "Plano": líneas guía de plano a lo ancho de la pantalla, el contorno se dibuja, las torres
 *    se levantan planta por planta y el wordmark se revela (sólo CSS).
 *  - ?intro2 "3D" (por defecto): logo 3D satinado en three.js; las piezas caen con resorte y gira hasta
 *    quedar de frente; luego flota, sigue al puntero y se puede arrastrar para girarlo (src/scripts/logo3d.ts).
 *  - ?intro3 "Partículas": partículas que llegan desde los bordes forman el logo, que golpea y queda sólido
 *    con onda expansiva y polvo (src/scripts/particles.ts).
 *  - ?intro4 "Partículas → 3D": como la 3, pero en el golpe el logo se convierte en el modelo 3D de la 2.
 *  - ?intro5 "Navbar": la intro original (el logo se construye a color sobre blanco) pero aterriza en el
 *    navbar: el blanco se encoge hasta ser la barra y el logo vuela al logo del header (nunca cambia de
 *    color). Debajo queda un hero de fotos con titular, al estilo de grascan.com.
 * Si el JS no arranca, las variantes 2–4 caen al logo plano. Con prefers-reduced-motion sale quieto.
 * El texto del hero del documento va en la franja inmediatamente inferior (index.astro).
 */
import { Image } from 'astro:assets';
import { u } from '@/lib/url';
import { site } from '@/site.config';
import { photos } from '@/data/photos';
import Logo from './Logo.astro';
import Button from './Button.astro';

// Variante 5: fotos del hero (fundido en bucle, sólo CSS)
const slides = [photos.torontoNight, photos.officeTowers, photos.commercialPavilion, photos.twinTowers];
---

<section class="hero relative bg-bone">
  <div class="hero-stage relative flex h-[100svh] min-h-[32rem] flex-col overflow-clip">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_40%,var(--color-concrete)_100%)]" aria-hidden="true"></div>
    <!-- Variante 5: hero de fotos (oculto en el resto; las imágenes lazy no se descargan si no se muestran) -->
    <div class="hero-photo on-dark absolute inset-0 hidden bg-ink text-bone">
      {slides.map((src, i) => <Image src={src} alt="" widths={[768, 1280, 1920, 2400]} sizes="100vw" loading="lazy" class="hero-slide absolute inset-0 h-full w-full object-cover" style={`--i:${i}`} />)}
      <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/55 to-ink/25"></div>
      <div class="container-x relative flex h-full flex-col justify-end pb-24 pt-(--header-h) md:pb-28">
        <p class="photo-in eyebrow text-bone/75" style="--k:0">Buildings & Development</p>
        <p class="photo-in mt-5 max-w-4xl font-wide text-[clamp(1.9rem,5vw,4.4rem)] uppercase leading-[1.04]" style="--k:1">Backed by Grascan Construction since {site.founded}.</p>
        <p class="photo-in mt-5 font-semiwide text-lg text-bone/75 md:text-xl" style="--k:2">Built on experience. Ready for what's next.</p>
        <div class="photo-in mt-9 flex flex-wrap gap-3" style="--k:3">
          <Button href={u('/contact?topic=project#form')}>Start a project</Button>
          <Button href={u('/services')} variant="ghost-light">Our services</Button>
        </div>
      </div>
    </div>
    <canvas class="hero-3d pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
    <canvas class="hero-fx pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true"></canvas>

    <div class="container-x pointer-events-none relative flex flex-1 items-center justify-center pt-(--header-h) pb-24">
      <h1 class="hero-mark relative w-[min(66vw,22rem)] md:w-[26rem]">
        <span class="guide guide-h" style="--y:0%;--k:0" aria-hidden="true"></span>
        <span class="guide guide-h" style="--y:78%;--k:1" aria-hidden="true"></span>
        <span class="guide guide-v" style="--x:20.1%;--k:2" aria-hidden="true"></span>
        <span class="guide guide-v" style="--x:79.6%;--k:3" aria-hidden="true"></span>
        <Logo variant="full" tone="original" class="hero-fill relative block w-full" />
        <Logo variant="full" outline class="hero-outline absolute inset-0 block w-full" />
        <span class="hero-shock" aria-hidden="true"></span>
        <span class="hero-shock" style="--k:1" aria-hidden="true"></span>
      </h1>
    </div>

    <a href="#intro-statement" class="hero-cue absolute bottom-8 left-1/2 -translate-x-1/2 p-2 text-signal/70 transition-colors hover:text-signal" aria-label="Scroll to content">
      <svg viewBox="0 0 24 24" class="hero-chevron size-7" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M6 6l6 6 6-6M6 12l6 6 6-6" /></svg>
    </a>
  </div>

  <!-- Variante 5: pantalla de intro que aterriza en el navbar -->
  <div class="intro5" aria-hidden="true">
    <div class="i5-bg"></div>
    <div class="i5-stage">
      <div class="i5-logo">
        <Logo variant="full" tone="original" class="block w-full" />
      </div>
      <span class="i5-line"></span>
    </div>
  </div>
</section>

<script>
  const mode = document.documentElement.dataset.intro;
  if (mode === '2') import('@/scripts/logo3d').then((m) => m.mountLogo3D()).catch(() => {});
  if (mode === '3' || mode === '4') import('@/scripts/particles').then((m) => m.mountParticles()).catch(() => {});
  if (mode === '4') import('@/scripts/logo3d').then((m) => m.mountLogo3D('impact')).catch(() => {});
  if (mode === '5') {
    // A dónde vuela el logo: su icono cae justo sobre el icono del logo del header
    const from = document.querySelector<HTMLElement>('.i5-logo');
    const to = document.querySelector<SVGElement>('#site-header .header-logo');
    if (from && to) {
      const a = from.getBoundingClientRect();
      const b = to.getBoundingClientRect();
      // icono: centro en (49.8%, 39%) del lockup apilado y en (7.5%, 50%) del horizontal; alto 78% vs 100%
      from.style.setProperty('--i5-dx', `${b.left + b.width * 0.075 - (a.left + a.width * 0.498)}px`);
      from.style.setProperty('--i5-dy', `${b.top + b.height * 0.5 - (a.top + a.height * 0.39)}px`);
      from.style.setProperty('--i5-s', String(b.height / (a.height * 0.78)));
    }
  }
</script>

<style is:global>
  /* Estado final / sin intro: sólo el logo a color */
  .hero .guide,
  .hero-outline {
    opacity: 0;
  }
  .hero .guide {
    position: absolute;
    pointer-events: none;
    background: color-mix(in oklab, var(--color-signal) 22%, transparent);
  }
  .hero .guide-h {
    top: var(--y);
    left: 50%;
    width: 200vw;
    height: 1px;
    translate: -50% 0;
  }
  .hero .guide-v {
    left: var(--x);
    top: 50%;
    width: 1px;
    height: 200svh;
    translate: 0 -50%;
  }
  .hero-outline path {
    fill: none !important;
    stroke: var(--color-signal);
    stroke-width: 2;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .hero-chevron {
    animation: nudge 2.4s ease-in-out infinite;
  }
  @keyframes nudge {
    50% {
      transform: translateY(5px);
    }
  }

  /* Header y cue esperan a que termine la intro (variantes 1 y 2) */
  html.has-intro:not(.intro-done) {
    overflow: hidden;
  }
  html.has-intro #site-header,
  html.has-intro .hero-cue {
    transition: opacity 0.8s ease;
  }
  html.has-intro:not(.intro-done) #site-header,
  html.has-intro:not(.intro-done) .hero-cue {
    opacity: 0;
    pointer-events: none;
  }

  /* ---------- Variante 1: Plano ---------- */
  html[data-intro='1'].has-intro .hero .guide {
    animation:
      guide-in 1s cubic-bezier(0.65, 0, 0.35, 1) calc(var(--k) * 120ms) both,
      fade-out 0.6s ease 2.3s forwards;
  }
  html[data-intro='1'].has-intro .hero .guide-h {
    --from: scaleX(0);
  }
  html[data-intro='1'].has-intro .hero .guide-v {
    --from: scaleY(0);
  }
  html[data-intro='1'].has-intro .hero-outline {
    opacity: 1;
    animation: fade-out 0.6s ease 2.3s forwards;
  }
  html[data-intro='1'].has-intro .hero-outline path {
    animation: draw-line 1s cubic-bezier(0.65, 0, 0.35, 1) both;
  }
  html[data-intro='1'].has-intro .hero-outline .logo-bar-1 { animation-delay: 0.2s; }
  html[data-intro='1'].has-intro .hero-outline .logo-bar-2 { animation-delay: 0.3s; }
  html[data-intro='1'].has-intro .hero-outline .logo-bar-3 { animation-delay: 0.4s; }
  html[data-intro='1'].has-intro .hero-outline .logo-word { animation-delay: 0.5s; }
  html[data-intro='1'].has-intro .hero-outline .logo-sub { animation-delay: 0.6s; }
  /* las torres se levantan planta por planta (steps) desde la base */
  html[data-intro='1'].has-intro .hero-fill .logo-bar {
    animation: rise 0.75s steps(8, end) both;
  }
  html[data-intro='1'].has-intro .hero-fill .logo-bar-1 { animation-delay: 1.1s; }
  html[data-intro='1'].has-intro .hero-fill .logo-bar-2 { animation-delay: 1.25s; }
  html[data-intro='1'].has-intro .hero-fill .logo-bar-3 { animation-delay: 1.4s; }
  html[data-intro='1'].has-intro .hero-fill .logo-word {
    animation: wipe 0.7s cubic-bezier(0.76, 0, 0.24, 1) 1.8s both;
  }
  html[data-intro='1'].has-intro .hero-fill .logo-sub {
    animation: wipe 0.6s cubic-bezier(0.76, 0, 0.24, 1) 2s both;
  }
  /* saltar: directo al estado final */
  html.intro-skip .hero .guide,
  html.intro-skip .hero-outline,
  html.intro-skip .hero-outline path,
  html.intro-skip .hero-fill path {
    animation: none !important;
  }
  html.intro-skip .hero .guide,
  html.intro-skip .hero-outline {
    opacity: 0;
  }

  /* ---------- Variantes 2–4 ---------- */
  /* el logo plano espera al 3D / a las partículas; si el JS no arranca, aparece solo */
  html[data-intro='2'] .hero-fill,
  html[data-intro='3'] .hero-fill,
  html[data-intro='4'] .hero-fill {
    animation: fade-in 0.6s ease 1.2s both;
  }
  html.logo-3d .hero-fill {
    visibility: hidden;
  }
  /* 3D: se arrastra para girarlo (en móvil el scroll vertical sigue funcionando) */
  html.logo-3d .hero-3d {
    pointer-events: auto;
    touch-action: pan-y;
    cursor: grab;
  }
  html.logo-grabbing .hero-3d {
    cursor: grabbing;
  }
  /* variante 4: el 3D aparece en el golpe de las partículas */
  html[data-intro='4']:not(.logo-hit) .hero-3d {
    opacity: 0;
  }
  /* Partículas: el logo sólido llega con un golpe, onda expansiva y temblor */
  html.particles-on .hero-fill {
    animation: none;
    opacity: 0;
  }
  html.particles-on.logo-hit .hero-fill {
    opacity: 1;
    transform-origin: 50% 78%;
    animation: slam 0.55s cubic-bezier(0.5, 0, 0.75, 0) both;
  }
  html.particles-on.logo-hit .hero-mark {
    animation: shake 0.42s linear 0.13s both;
  }
  .hero-shock {
    position: absolute;
    left: 50%;
    top: 78%;
    width: 100%;
    aspect-ratio: 1;
    border: 1.5px solid var(--color-signal);
    border-radius: 50%;
    opacity: 0;
    translate: -50% -50%;
    pointer-events: none;
  }
  html.particles-on.logo-hit .hero-shock {
    animation: shock 0.9s cubic-bezier(0.16, 1, 0.3, 1) calc(0.13s + var(--k, 0) * 0.12s) both;
  }

  /* ---------- Variante 5: aterriza en el navbar ---------- */
  .intro5 {
    display: none;
  }
  html[data-intro='5'] .hero-photo {
    display: block;
  }
  html[data-intro='5'] .hero-mark,
  html[data-intro='5'] .hero-3d,
  html[data-intro='5'] .hero-fx {
    display: none;
  }
  html[data-intro='5'] .hero-cue {
    color: color-mix(in oklab, var(--color-bone) 80%, transparent);
  }
  .hero-slide {
    opacity: 0;
    animation: slide 24s linear infinite;
    animation-delay: calc(var(--i) * 6s - 0.5s);
  }
  @keyframes slide {
    0% {
      opacity: 0;
      transform: scale(1.08);
    }
    6%,
    25% {
      opacity: 1;
    }
    31%,
    100% {
      opacity: 0;
      transform: scale(1);
    }
  }
  /* navbar blanco sólido con el logo a color visible: es donde aterriza la intro */
  html[data-intro='5'] #site-header .header-bg {
    background: var(--color-bone);
    border-color: color-mix(in oklab, var(--color-ink) 8%, transparent);
  }
  html[data-intro='5'] #site-header.hero-logo .header-logo {
    opacity: 1 !important; /* gana a la regla del header que lo oculta sobre el hero */
  }
  html[data-intro='5'].has-intro #site-header {
    opacity: 1;
    pointer-events: auto;
  }
  html[data-intro='5'].has-intro .photo-in {
    animation: photo-in 1.2s cubic-bezier(0.16, 1, 0.3, 1) calc(2.35s + var(--k) * 0.14s) both;
  }
  html[data-intro='5'].has-intro .intro5 {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 60;
    animation: i5-hide 0s linear 2.75s forwards;
  }
  .i5-bg {
    position: absolute;
    inset: 0;
    background: var(--color-bone);
    animation:
      i5-collapse 0.9s cubic-bezier(0.76, 0, 0.24, 1) 1.65s both,
      i5-out 0.3s ease 2.4s forwards; /* ya es la barra: se funde con el navbar real de debajo */
  }
  .i5-stage {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
  }
  .i5-logo {
    width: min(62vw, 21rem);
    transform-origin: 49.8% 39%;
    animation: i5-land 0.9s cubic-bezier(0.76, 0, 0.24, 1) 1.65s both;
  }
  @media (min-width: 48rem) {
    .i5-logo {
      width: 24rem;
    }
  }
  /* construcción original: las torres crecen desde la base y el wordmark se revela;
     en vuelo el wordmark apilado se va y sólo el icono cae sobre el del header */
  .i5-logo .logo-bar {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: i5-rise 1s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .i5-logo .logo-bar-1 { animation-delay: 0.2s; }
  .i5-logo .logo-bar-2 { animation-delay: 0.32s; }
  .i5-logo .logo-bar-3 { animation-delay: 0.44s; }
  .i5-logo .logo-word {
    animation:
      wipe 0.9s cubic-bezier(0.76, 0, 0.24, 1) 0.65s both,
      i5-out 0.35s ease 1.7s forwards;
  }
  .i5-logo .logo-sub {
    animation:
      i5-fade 0.8s ease 1s both,
      i5-out 0.35s ease 1.7s forwards;
  }
  .i5-line {
    display: block;
    margin-top: 2.5rem;
    width: min(50vw, 14rem);
    height: 1px;
    background: color-mix(in oklab, var(--color-signal) 35%, transparent);
    transform: scaleX(0);
    transform-origin: left;
    animation:
      i5-load 1.3s cubic-bezier(0.65, 0, 0.35, 1) 0.1s forwards,
      i5-out 0.4s ease 1.45s forwards;
  }
  html.intro-skip .intro5 {
    display: none !important;
  }
  html.intro-skip .photo-in {
    animation: none !important;
  }
  @keyframes i5-rise {
    from {
      transform: scaleY(0);
    }
  }
  @keyframes i5-fade {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  @keyframes i5-load {
    to {
      transform: scaleX(1);
    }
  }
  @keyframes i5-out {
    to {
      opacity: 0;
    }
  }
  @keyframes i5-collapse {
    to {
      clip-path: inset(0 0 calc(100% - var(--header-h)) 0);
    }
  }
  @keyframes i5-land {
    80% {
      opacity: 1;
    }
    to {
      transform: translate(var(--i5-dx, 0px), var(--i5-dy, 0px)) scale(var(--i5-s, 0.2));
      opacity: 0;
    }
  }
  @keyframes i5-hide {
    to {
      visibility: hidden;
    }
  }
  @keyframes photo-in {
    from {
      opacity: 0;
      translate: 0 18px;
    }
  }

  @keyframes guide-in {
    from {
      transform: var(--from);
      opacity: 1;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  @keyframes draw-line {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes rise {
    from {
      clip-path: inset(100% 0 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes wipe {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes slam {
    0% {
      transform: scale(1.1);
    }
    24% {
      transform: scale(0.97);
      animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    }
    100% {
      transform: none;
    }
  }
  @keyframes shake {
    0%, 100% { translate: 0 0; }
    20% { translate: -5px 3px; }
    40% { translate: 4px -2px; }
    60% { translate: -3px 1px; }
    80% { translate: 2px 0; }
  }
  @keyframes shock {
    from {
      opacity: 0.55;
      transform: scale(0.2, 0.06);
    }
    to {
      opacity: 0;
      transform: scale(2.6, 0.7);
    }
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
  @keyframes fade-out {
    to {
      opacity: 0;
    }
  }
</style>
