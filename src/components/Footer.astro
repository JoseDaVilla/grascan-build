---
import { u } from '@/lib/url';
import { site, menu, office } from '@/site.config';
const groups = menu.filter((m) => ['Health & Safety', 'About', 'Careers'].includes(m.label));
import { services, markets } from '@/data/services';
import { logo } from '@/lib/logo';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer class="on-dark relative overflow-hidden bg-ink text-bone">

  <div class="container-x relative pt-20 pb-10 md:pt-28">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <Logo variant="full" class="w-40 text-bone md:w-48" />
        <p class="mt-8 font-wide text-lg">{site.legalName}</p>
        <p class="mt-2 max-w-sm text-sm text-bone/70">Commercial Construction · Industrial Construction · Institutional Construction</p>
        <p class="mt-5 font-wide text-signal">{site.tagline}</p>
        <a href={u('/contact?topic=project#form')} class="btn btn-primary mt-8"><span>Start a project</span></a>
      </div>

      <div class="grid grid-cols-2 gap-10 sm:grid-cols-3 xl:grid-cols-5 lg:col-span-8">
        <div class="col-span-2 sm:col-span-1 sm:row-span-2 xl:row-span-1">
          <p class="eyebrow mb-5"><a class="link-u text-gray" href={u('/services')}>Services</a></p>
          <ul class="space-y-2 text-sm text-bone/80">
            {services.map((s) => <li><a class="link-u" href={u(`/services#${s.slug}`)}>{s.title}</a></li>)}
          </ul>
          <p class="eyebrow mb-5 mt-10"><a class="link-u text-gray" href={u('/markets')}>Markets</a></p>
          <ul class="space-y-2 text-sm text-bone/80">
            {markets.map((m) => <li><a class="link-u" href={u(`/markets#${m.slug}`)}>{m.title}</a></li>)}
          </ul>
        </div>
        {
          groups.map((g) => (
            <div>
              <p class="eyebrow mb-5"><a class="link-u text-gray" href={u(g.href)}>{g.label}</a></p>
              <ul class="space-y-2 text-sm text-bone/80">
                {g.children?.map((c) => <li><a class="link-u" href={u(c.href)}>{c.label}</a></li>)}
              </ul>
            </div>
          ))
        }
        <div>
          <p class="eyebrow mb-5"><a class="link-u text-gray" href={u('/projects')}>Projects</a></p>
          <ul class="space-y-2 text-sm text-bone/80">
            <li><a class="link-u" href={u('/projects')}>Project Listing</a></li>
          </ul>
          <p class="eyebrow mb-5 mt-10"><a class="link-u text-gray" href={u('/contact')}>Contact</a></p>
          <ul class="space-y-2 text-sm text-bone/80">
            <li><a class="link-u" href={u('/contact')}>Contact Us</a></li>
            <li class="text-bone/60">{office.city}</li>
            {site.email && <li><a class="link-u" href={`mailto:${site.email}`}>{site.email}</a></li>}
            {site.phone && <li><a class="link-u" href={`tel:${site.phone.replace(/[^+\d]/g, '')}`}>{site.phone}</a></li>}
          </ul>
        </div>
      </div>
    </div>

    <!-- Wordmark gigante (trazado del logo) -->
    <div class="footer-word relative mt-20 select-none" aria-hidden="true">
      <svg viewBox="0 485 602 58" class="w-full text-bone/[0.06]"><path d={logo.word} fill="currentColor" fill-rule="evenodd" /></svg>
      <span class="absolute -bottom-4 left-0 w-full origin-left bg-gray" data-reveal="fade"></span>
    </div>

    <div class="mt-12 flex flex-col gap-6 border-t border-bone/10 pt-8 text-sm text-bone/50 md:flex-row md:items-center md:justify-between">
      <p>© {year} {site.legalName}. All rights reserved.</p>
      <ul class="flex flex-wrap gap-6">
        <li><a class="link-u" href={u('/privacy')}>Privacy Policy</a></li>
        <li><a class="link-u" href={u('/terms')}>Terms & Conditions</a></li>
        {site.social.map((s) => <li><a class="link-u" href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
        <li><a class="link-u" href="#top">Back to top ↑</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer-word span {
    height: 2px;
    transform: scaleX(0);
    transition: transform 1.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .footer-word span:global(.is-in) {
    transform: none;
  }
</style>
