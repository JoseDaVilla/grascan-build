---
/**
 * Cabecera de páginas interiores: foto de fondo con velo navy y texto claro.
 * Usar junto con <Base darkHero> para que el header sea claro sobre ella.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import SplitText from './SplitText.astro';
import Eyebrow from './Eyebrow.astro';
interface Props { eyebrow: string; title: string; lead?: string; index?: string; accent?: string[]; image?: ImageMetadata }
const { eyebrow, title, lead, accent = [], image } = Astro.props;
---
<section class="on-dark relative overflow-hidden bg-ink pt-[calc(var(--header-h)+5rem)] pb-16 text-bone md:pb-24">
  {
    image && (
      <div class="absolute inset-0" aria-hidden="true">
        <Image src={image} alt="" widths={[768, 1280, 1920]} sizes="100vw" loading="eager" class="h-full w-full object-cover" />
        <div class="absolute inset-0 bg-[linear-gradient(90deg,rgb(4_31_66/0.94)_0%,rgb(4_31_66/0.82)_55%,rgb(4_31_66/0.6)_100%)]"></div>
      </div>
    )
  }

  <div class="container-x relative">
    <div class="lg:max-w-[62%]">
      <Eyebrow class="mb-6 text-bone/70">{eyebrow}</Eyebrow>
      <SplitText as="h1" text={title} accent={accent} class="max-w-5xl font-wide text-display" />
      {lead && <p class="mt-8 max-w-2xl text-lead text-bone/85 md:mt-10" data-reveal style="--d:4">{lead}</p>}
      <slot />
    </div>
  </div>
</section>
