---
/**
 * Imagen optimizada (astro:assets). Sin `src` muestra un panel neutro (sin ilustraciones).
 * `overlay` oscurece la foto para poner texto encima.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src?: ImageMetadata | string;
  alt?: string;
  /** Compatibilidad con llamadas antiguas: se ignoran. */
  seed?: string;
  variant?: string;
  label?: boolean;
  tone?: 'dark' | 'light';
  class?: string;
  imgClass?: string;
  sizes?: string;
  widths?: number[];
  eager?: boolean;
  overlay?: boolean;
}

const {
  src,
  alt = '',
  tone = 'light',
  class: cls = '',
  imgClass = '',
  sizes = '(min-width: 1024px) 50vw, 100vw',
  widths = [480, 800, 1200, 1600, 2000],
  eager = false,
  overlay = false,
} = Astro.props;

const pos = /\b(absolute|fixed)\b/.test(cls) ? '' : 'relative';
---

<div class:list={[pos, 'overflow-hidden', cls, !src && (tone === 'dark' ? 'bg-ink-2' : 'bg-concrete')]}>
  {
    src &&
      (typeof src === 'string' ? (
        <img src={src} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" class:list={['h-full w-full object-cover', imgClass]} />
      ) : (
        <Image
          src={src}
          alt={alt}
          widths={widths.filter((w) => w <= src.width)}
          sizes={sizes}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : 'auto'}
          class:list={['h-full w-full object-cover', imgClass]}
        />
      ))
  }
  {overlay && <div class="absolute inset-0 bg-ink/55" aria-hidden="true" />}
  <slot />
</div>
