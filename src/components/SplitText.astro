---
/**
 * Divide un texto en líneas (separadas por "|") y palabras en build time,
 * para animarlas con CSS sin layout shift ni JS pesado.
 */
import type { HTMLTag } from 'astro/types';
interface Props { text: string; as?: HTMLTag; class?: string; delay?: number; accent?: string[]; afterIntro?: boolean }
const { text, as: Tag = 'h2', class: cls = '', delay = 0, accent = [], afterIntro = false } = Astro.props;
const base = afterIntro ? `calc(var(--intro-delay, 0ms) + ${delay}ms)` : `${delay}ms`;
const lines = text.split('|').map((l) => l.trim().split(/\s+/));
// Ancho aproximado (en em) de la palabra más larga: el CSS limita el tamaño para que nunca se corte
// en pantallas estrechas (y main.ts lo afina midiendo). font-editorial = Manrope negrita en
// mayúsculas; el resto usa una tabla genérica algo más holgada.
const editorial = cls.includes('font-editorial');
const charEm = editorial
  ? (c: string) => (/[MW]/i.test(c) ? 0.98 : /[I1.,'’:;!|]/i.test(c) ? 0.32 : 0.74)
  : (c: string) => (/[MW]/i.test(c) ? 1 : /[I1.,'’:;!]/i.test(c) ? 0.35 : 0.72);
const longest = Math.max(...lines.flat().map((w) => [...w].reduce((sum, c) => sum + charEm(c), 0)));
let i = 0;
---
<Tag class={cls} data-split style={`--base:${base};--lw:${longest.toFixed(2)}`} aria-label={text.replaceAll('|', ' ')}>
  {lines.map((words) => (
    <span class="split-line" aria-hidden="true">
      {words.map((w, wi) => (
        <>
          <span class:list={['split-word', { 'text-gray': accent.includes(w) }]} style={`--i:${i++}`}>{w}</span>
          {wi < words.length - 1 && ' '}
        </>
      ))}
    </span>
  ))}
</Tag>
