---
/**
 * Intro corporativa (sólo home): fondo navy, el logo Grascan Build se construye en blanco
 * (las torres crecen, el wordmark se revela) sobre una línea fina de carga. Después el logo
 * se desliza a su posición exacta en el hero (lo calcula main.ts) y el navy se disuelve dejando
 * ver las fotos: transición continua intro → hero.
 * Una vez por sesión (o forzada con ?intro), se puede saltar con clic / tecla y respeta
 * prefers-reduced-motion.
 *
 * Línea de tiempo: 0.2–1.4 s logo y línea · 1.5 s el logo viaja al hero · 2.2 s el fondo se
 * disuelve · 2.9 s la intro desaparece.
 */
import Logo from './Logo.astro';
---

<div id="intro" class="intro on-dark" aria-hidden="true">
  <div class="intro-bg"></div>
  <div class="intro-stage">
    <div class="intro-logo">
      <Logo variant="full" animate delay={200} class="block w-full !text-bone" />
    </div>
    <span class="intro-line"></span>
  </div>
</div>

<style is:global>
  .intro {
    display: none;
  }
  html.has-intro .intro {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 100;
    pointer-events: auto;
    animation: intro-hide 0s linear 2.9s forwards;
  }
  html.has-intro {
    /* las animaciones del hero (textos) empiezan cuando el fondo de la intro se disuelve */
    --intro-delay: 2200ms;
  }
  html.has-intro:not(.intro-done) {
    overflow: hidden;
  }
  /* Durante la intro el logo del hero está quieto y visible bajo ella: así el relevo es exacto */
  html.has-intro .hero h1.hero-fade {
    animation: none;
    opacity: 1;
  }
  @keyframes intro-hide {
    to {
      visibility: hidden;
      pointer-events: none;
    }
  }

  .intro-bg {
    position: absolute;
    inset: 0;
    background: var(--color-ink);
    animation: intro-fade-out 0.7s ease 2.2s forwards;
  }
  .intro-stage {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
  }
  /* Mismo ancho que el logo del hero (Hero.astro) para que no haya cambio de escala */
  .intro-logo {
    width: min(62vw, 21rem);
    transform: translate(var(--intro-dx, 0px), var(--intro-dy, 0px));
    transition: transform 0.9s cubic-bezier(0.76, 0, 0.24, 1);
  }
  @media (min-width: 48rem) {
    .intro-logo {
      width: 24rem;
    }
  }
  .intro-line {
    display: block;
    margin-top: 2.5rem;
    width: min(50vw, 14rem);
    height: 1px;
    background: color-mix(in oklab, var(--color-bone) 70%, transparent);
    transform: scaleX(0);
    transform-origin: left;
    animation:
      intro-load 1.3s cubic-bezier(0.65, 0, 0.35, 1) 0.1s forwards,
      intro-fade-out 0.4s ease 1.45s forwards;
  }
  @keyframes intro-load {
    to {
      transform: scaleX(1);
    }
  }
  @keyframes intro-fade-out {
    to {
      opacity: 0;
    }
  }

  /* Saltar la intro (clic / tecla): fundido rápido */
  html.intro-skip .intro {
    animation: intro-hide 0s linear 0.5s forwards;
  }
  html.intro-skip .intro-bg,
  html.intro-skip .intro-stage {
    animation: intro-fade-out 0.45s ease forwards !important;
  }
</style>
